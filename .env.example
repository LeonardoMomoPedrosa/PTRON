# PTRON Environment Variables Example
# Copy this file to .env and fill in your values
# These can also be set as environment variables with the PTRON_ prefix

# Site Configuration
PTRON_SiteUrl=https://makelectron.com

# Google Tag Manager
# Get your Container ID from https://tagmanager.google.com/
PTRON_GoogleTagManager__ContainerId=GTM-XXXXXX

# Google Analytics 4
# Get your Measurement ID from https://analytics.google.com/
PTRON_GoogleAnalytics__MeasurementId=G-XXXXXXXXXX
PTRON_GoogleAnalytics__AnonymizeIp=true

# Google Ads
# Get your Conversion ID from https://ads.google.com/
PTRON_GoogleAds__ConversionId=AW-XXXXXXXXX
PTRON_GoogleAds__EnableRemarketing=true
PTRON_GoogleAds__EnableEnhancedConversions=false

# Database
PTRON_ConnectionStrings__Default=Data Source=ptron.db

# API Token
PTRON_Api__Token=ptron-dev-token-8f4c2a91

# Email Configuration (SMTP)
PTRON_Smtp__Host=smtp.example.com
PTRON_Smtp__Port=587
PTRON_Smtp__SecureSocketOptions=StartTls
PTRON_Smtp__FromName=Makelectron
PTRON_Smtp__Username=
PTRON_Smtp__Password=

# Leo Admin
PTRON_Leo__Email=pedrosa.leonardo@gmail.com
