<PageTitle>@L["Makelectron — Controle de Produção e Gestão de Estoque"]</PageTitle>

<SeoMeta 
    Title="@L["Makelectron — Controle de Produção e Gestão de Estoque"]"
    Description="@L["Sistema completo para gestão de estoque de componentes, controle de produção e cálculo automático de custos. Ideal para eletrônica, artesanato e montagens complexas."]"
    Keywords="@L["controle de produção, gestão de estoque, BOM, bill of materials, custo médio ponderado, eletrônica, componentes"]"
    OgImage="/fancy_image.jpg"
    OgImageAlt="@L["Sistema de controle de produção Makelectron"]"
    TwitterCard="summary_large_image"
/>

<StructuredData Type="WebApplication" 
    Name="Makelectron"
    Description="@L["Aplicativo web para controle de produção, gestão de estoque de componentes e cálculo de custos com suporte a múltiplas moedas"]"
    ApplicationCategory="BusinessApplication"
    OperatingSystem="Any"
    BrowserRequirements="Requires JavaScript. Requires HTML5."
    Image="/fancy_image.jpg"
/>

<StructuredData Type="Organization" 
    Name="Makelectron"
    Description="@L["Sistema de controle de produção e gestão de estoque para equipamentos eletrônicos"]"
    Logo="/logo.png"
/>

<GoogleTagManager />
<GoogleAnalytics />
<GoogleAds />

<main class="welcome-main">
    <section class="welcome-hero">
        <div class="welcome-wrap">
            <div class="welcome-hero-copy">
                <h1>@L["Muitas peças. Tudo sob controle."]</h1>
                <p class="welcome-lead">@L["Estoque, produção e o custo de cada unidade."]</p>
                <p class="welcome-support">
                    @L["Quando o produto final é feito de muitas partes, controlar isso na mão deixa de funcionar."]
                    @L["O Makelectron guarda a lista, confere o estoque na hora de produzir e calcula o custo em reais."]
                    @L["Feito para eletrônica, e do mesmo jeito para artesanato ou qualquer outra montagem."]
                </p>
                <div class="welcome-actions">
                    <MudButton Href="/cadastro" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large">@L["Criar conta"]</MudButton>
                    <MudButton Href="/login" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Large">@L["Entrar"]</MudButton>
                </div>
            </div>

            <figure class="welcome-flow">
                <img src="fancy_image.jpg" alt="@L["Peças entram numa lista, passam pelo estoque e pela produção, e saem como uma unidade que custa R$ 186,40."]" />
            </figure>
        </div>
    </section>

    <section class="welcome-band">
        <div class="welcome-wrap welcome-who">
            <h2>@L["Para quem é"]</h2>
            <p>@L["Quem faz um produto final de muitas peças — equipamento eletrônico, trabalho de artesão ou qualquer outra montagem."]</p>
        </div>
    </section>

    <section class="welcome-section">
        <div class="welcome-wrap">
            <h2>@L["O que hoje dá errado"]</h2>
            <div class="welcome-cards">
                <article>
                    <h3>@L["A lista não cabe na cabeça"]</h3>
                    <p>@L["Na hora de montar, falta uma peça no meio de muitas."]</p>
                </article>
                <article>
                    <h3>@L["O custo da unidade não fecha"]</h3>
                    <p>@L["Cada peça entrou com um preço, às vezes em outra moeda."]</p>
                </article>
                <article>
                    <h3>@L["O estoque tem de andar junto"]</h3>
                    <p>@L["Produziu uma unidade, ou desmontou: o estoque de cada peça tem de andar junto."]</p>
                </article>
            </div>
        </div>
    </section>

    <section class="welcome-band">
        <div class="welcome-wrap">
            <h2>@L["Como funciona"]</h2>
            <ol class="welcome-steps">
                <li>
                    <span class="welcome-step-num" aria-hidden="true">1</span>
                    <div>
                        <h3>@L["Cadastra cada peça"]</h3>
                        <p>@L["Tipo, foto, saldo e custo. O tipo é um nome: resistor, madeira, tecido, frasco."]</p>
                    </div>
                </li>
                <li>
                    <span class="welcome-step-num" aria-hidden="true">2</span>
                    <div>
                        <h3>@L["Monta o modelo"]</h3>
                        <p>@L["A lista inteira do que o produto final leva."]</p>
                    </div>
                </li>
                <li>
                    <span class="welcome-step-num" aria-hidden="true">3</span>
                    <div>
                        <h3>@L["Dá entrada no estoque"]</h3>
                        <p>@L["Produtos, impostos e frete podem estar em moedas diferentes. O custo de cada peça fica em reais."]</p>
                    </div>
                </li>
                <li>
                    <span class="welcome-step-num" aria-hidden="true">4</span>
                    <div>
                        <h3>@L["Produz"]</h3>
                        <p>@L["Confere a lista contra o saldo e para se faltar alguma peça. A unidade sai com o custo de todas elas."]</p>
                    </div>
                </li>
            </ol>
        </div>
    </section>

    <section class="welcome-section">
        <div class="welcome-wrap">
            <h2>@L["O que passa a ficar registrado"]</h2>
            <ul class="welcome-caps">
                <li>
                    <MudIcon Icon="@Icons.Material.Filled.Category" Color="Color.Primary" aria-hidden="true" />
                    <span>@L["Tipos com o nome que você quiser."]</span>
                </li>
                <li>
                    <MudIcon Icon="@Icons.Material.Filled.PhotoCamera" Color="Color.Primary" aria-hidden="true" />
                    <span>@L["Foto da peça."]</span>
                </li>
                <li>
                    <MudIcon Icon="@Icons.Material.Filled.DeveloperBoard" Color="Color.Primary" aria-hidden="true" />
                    <span>@L["A lista inteira do que o modelo leva."]</span>
                </li>
                <li>
                    <MudIcon Icon="@Icons.Material.Filled.Calculate" Color="Color.Primary" aria-hidden="true" />
                    <span>@L["Custo médio ponderado de cada peça."]</span>
                </li>
                <li>
                    <MudIcon Icon="@Icons.Material.Filled.Paid" Color="Color.Primary" aria-hidden="true" />
                    <span>@L["Compra em BRL, USD, EUR, GBP ou CNY."]</span>
                </li>
                <li>
                    <MudIcon Icon="@Icons.Material.Filled.PrecisionManufacturing" Color="Color.Primary" aria-hidden="true" />
                    <span>@L["Produção que confere o saldo de cada peça."]</span>
                </li>
                <li>
                    <MudIcon Icon="@Icons.Material.Filled.Lock" Color="Color.Primary" aria-hidden="true" />
                    <span>@L["O custo da unidade fica congelado: mudar o modelo não reescreve o que já foi feito."]</span>
                </li>
                <li>
                    <MudIcon Icon="@Icons.Material.Filled.Undo" Color="Color.Primary" aria-hidden="true" />
                    <span>@L["Excluir a unidade devolve cada peça ao estoque."]</span>
                </li>
            </ul>
        </div>
    </section>

    <section class="welcome-close">
        <div class="welcome-wrap">
            <p class="welcome-close-title">@L["Muitas peças. Tudo sob controle."]</p>
            <div class="welcome-actions welcome-actions-center">
                <MudButton Href="/cadastro" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Class="welcome-close-primary">@L["Criar conta"]</MudButton>
                <MudButton Href="/login" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Large" Class="welcome-close-secondary">@L["Entrar"]</MudButton>
            </div>
        </div>
    </section>
</main>

<footer class="welcome-footer">
    <div class="welcome-wrap">
        <BrandLogo Height="28" />
        <p>@L["Estoque, produção e custo para produtos feitos de muitas peças."]</p>
        <p class="welcome-beta">@L["Versão beta, ainda em testes."]</p>
        <p class="welcome-beta">@L["Código aberto, licença MIT."] <MudLink Href="https://github.com/LeonardoMomoPedrosa/PTRON" Target="_blank" rel="noopener noreferrer" Color="Color.Primary">@L["Ver no GitHub"]</MudLink></p>
        <nav aria-label="@L["Conta"]">
            <MudLink Href="/login" Color="Color.Primary">@L["Entrar"]</MudLink>
            <MudLink Href="/cadastro" Color="Color.Primary">@L["Criar conta"]</MudLink>
        </nav>
    </div>
</footer>
