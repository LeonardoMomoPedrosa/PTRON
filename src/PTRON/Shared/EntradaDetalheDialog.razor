<MudDialog>
    <DialogContent>
        <MudGrid Class="mb-2">
            <MudItem xs="6" sm="3">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@L["Produtos"]</MudText>
                <MudText>@Format.Money(Entrada.TotalProdutos, Entrada.MoedaProdutos)</MudText>
                @if (Entrada.MoedaProdutos != Moedas.Destino)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        @L["câmbio {0} / {1} 1", Format.Money(Entrada.CambioProdutos), Moedas.Symbol(Entrada.MoedaProdutos)]
                    </MudText>
                }
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@L["Frete"]</MudText>
                <MudText>@Format.Money(Entrada.Frete, Entrada.MoedaFrete)</MudText>
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@L["Impostos"]</MudText>
                <MudText>@Format.Money(Entrada.Impostos, Entrada.MoedaImpostos)</MudText>
                @if (Entrada.MoedaImpostos != Moedas.Destino && Entrada.MoedaImpostos != Entrada.MoedaProdutos)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        @L["câmbio {0} / {1} 1", Format.Money(Entrada.CambioImpostos), Moedas.Symbol(Entrada.MoedaImpostos)]
                    </MudText>
                }
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@L["Total em R$"]</MudText>
                <MudText Typo="Typo.subtitle1"><b>@Format.Money(Entrada.TotalBrl)</b></MudText>
            </MudItem>
        </MudGrid>

        <MudTable Items="Linhas" Dense="true" Hover="true" Elevation="0" Breakpoint="Breakpoint.Md">
            <HeaderContent>
                <MudTh>@L["Insumo"]</MudTh>
                <MudTh Style="text-align:right">@L["Qtd"]</MudTh>
                <MudTh Style="text-align:right">@L["Preço unit."]</MudTh>
                <MudTh Style="text-align:right">@L["Subtotal"]</MudTh>
                <MudTh Style="text-align:right">@L["Proporção"]</MudTh>
                <MudTh Style="text-align:right">@L["Frete"]</MudTh>
                <MudTh Style="text-align:right">@L["Impostos"]</MudTh>
                <MudTh Style="text-align:right">@L["Custo unit. (R$)"]</MudTh>
                <MudTh Style="text-align:right">@L["Total (R$)"]</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@L["Insumo"]">
                    @if (context.Item.Insumo is not null)
                    {
                        <MudText Typo="Typo.body2">@context.Item.Insumo.Nome</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            @InsumoDetalhe(context.Item.Insumo)
                        </MudText>
                    }
                </MudTd>
                <MudTd DataLabel="@L["Qtd"]" Style="text-align:right">@Format.Number(context.Item.Qtd)</MudTd>
                <MudTd DataLabel="@L["Preço unit."]" Style="text-align:right">
                    @Format.Money(context.Item.PrecoUnitario, Entrada.MoedaProdutos)
                </MudTd>
                <MudTd DataLabel="@L["Subtotal"]" Style="text-align:right">
                    @Format.Money(context.Subtotal, Entrada.MoedaProdutos)
                </MudTd>
                <MudTd DataLabel="@L["Proporção"]" Style="text-align:right">@Format.Percent(context.Proporcao)</MudTd>
                <MudTd DataLabel="@L["Frete"]" Style="text-align:right">
                    @Format.Money(context.Item.FreteRateado, Entrada.MoedaFrete)
                </MudTd>
                <MudTd DataLabel="@L["Impostos"]" Style="text-align:right">
                    @Format.Money(context.Item.ImpostoRateado, Entrada.MoedaImpostos)
                </MudTd>
                <MudTd DataLabel="@L["Custo unit. (R$)"]" Style="text-align:right">
                    @Format.Money(context.Item.CustoUnitario)
                </MudTd>
                <MudTd DataLabel="@L["Total (R$)"]" Style="text-align:right">@Format.Money(context.SubtotalBrl)</MudTd>
            </RowTemplate>
            <FooterContent>
                <MudTd></MudTd>
                <MudTd></MudTd>
                <MudTd Style="text-align:right"><b>@L["Total"]</b></MudTd>
                <MudTd Style="text-align:right">
                    <b>@Format.Money(Entrada.TotalProdutos, Entrada.MoedaProdutos)</b>
                </MudTd>
                <MudTd></MudTd>
                <MudTd Style="text-align:right"><b>@Format.Money(Entrada.Frete, Entrada.MoedaFrete)</b></MudTd>
                <MudTd Style="text-align:right"><b>@Format.Money(Entrada.Impostos, Entrada.MoedaImpostos)</b></MudTd>
                <MudTd></MudTd>
                <MudTd Style="text-align:right"><b>@Format.Money(Entrada.TotalBrl)</b></MudTd>
            </FooterContent>
        </MudTable>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close" Color="Color.Primary" Variant="Variant.Filled">@L["Fechar"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public EntradaEstoque Entrada { get; set; } = default!;

    private IEnumerable<Linha> Linhas => Entrada.Itens.Select(item =>
    {
        var subtotal = item.Qtd * item.PrecoUnitario;
        return new Linha
        {
            Item = item,
            Subtotal = subtotal,
            Proporcao = EntradaCustoCalculator.Proporcao(
                subtotal,
                Entrada.TotalProdutos,
                item.Qtd,
                Entrada.Itens.Sum(i => i.Qtd)),
            SubtotalBrl = Entrada.SubtotalDestino(item)
        };
    });

    private void Close() => MudDialog.Close();

    private static string InsumoDetalhe(Insumo i)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(i.TipoInsumo?.Nome)) parts.Add(i.TipoInsumo.Nome);
        if (!string.IsNullOrWhiteSpace(i.Valor)) parts.Add(i.Valor!);
        if (!string.IsNullOrWhiteSpace(i.Potencia)) parts.Add(i.Potencia!);
        if (!string.IsNullOrWhiteSpace(i.Voltagem)) parts.Add(i.Voltagem!);
        return parts.Count == 0 ? "—" : string.Join(" · ", parts);
    }

    private sealed class Linha
    {
        public EntradaEstoqueItem Item { get; init; } = default!;
        public decimal Subtotal { get; init; }
        public decimal Proporcao { get; init; }
        public decimal SubtotalBrl { get; init; }
    }
}
