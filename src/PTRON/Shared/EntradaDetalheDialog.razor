<MudDialog>
    <DialogContent>
        <MudGrid Class="mb-2">
            <MudItem xs="6" sm="3">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Produtos</MudText>
                <MudText>@Format.Money(Entrada.TotalProdutos, Entrada.MoedaProdutos)</MudText>
                @if (Entrada.MoedaProdutos != Moedas.Destino)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        câmbio @Format.Money(Entrada.CambioProdutos) / @Moedas.Symbol(Entrada.MoedaProdutos) 1
                    </MudText>
                }
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Frete</MudText>
                <MudText>@Format.Money(Entrada.Frete, Entrada.MoedaFrete)</MudText>
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Impostos</MudText>
                <MudText>@Format.Money(Entrada.Impostos, Entrada.MoedaImpostos)</MudText>
                @if (Entrada.MoedaImpostos != Moedas.Destino && Entrada.MoedaImpostos != Entrada.MoedaProdutos)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        câmbio @Format.Money(Entrada.CambioImpostos) / @Moedas.Symbol(Entrada.MoedaImpostos) 1
                    </MudText>
                }
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Total em R$</MudText>
                <MudText Typo="Typo.subtitle1"><b>@Format.Money(Entrada.TotalBrl)</b></MudText>
            </MudItem>
        </MudGrid>

        <MudTable Items="Linhas" Dense="true" Hover="true" Elevation="0" Breakpoint="Breakpoint.Md">
            <HeaderContent>
                <MudTh>Insumo</MudTh>
                <MudTh Style="text-align:right">Qtd</MudTh>
                <MudTh Style="text-align:right">Preço unit.</MudTh>
                <MudTh Style="text-align:right">Subtotal</MudTh>
                <MudTh Style="text-align:right">Proporção</MudTh>
                <MudTh Style="text-align:right">Frete</MudTh>
                <MudTh Style="text-align:right">Impostos</MudTh>
                <MudTh Style="text-align:right">Custo unit. (R$)</MudTh>
                <MudTh Style="text-align:right">Total (R$)</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Insumo">
                    @if (context.Item.Insumo is not null)
                    {
                        <MudText Typo="Typo.body2">@context.Item.Insumo.Nome</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            @InsumoDetalhe(context.Item.Insumo)
                        </MudText>
                    }
                </MudTd>
                <MudTd DataLabel="Qtd" Style="text-align:right">@Format.Number(context.Item.Qtd)</MudTd>
                <MudTd DataLabel="Preço unit." Style="text-align:right">
                    @Format.Money(context.Item.PrecoUnitario, Entrada.MoedaProdutos)
                </MudTd>
                <MudTd DataLabel="Subtotal" Style="text-align:right">
                    @Format.Money(context.Subtotal, Entrada.MoedaProdutos)
                </MudTd>
                <MudTd DataLabel="Proporção" Style="text-align:right">@Format.Percent(context.Proporcao)</MudTd>
                <MudTd DataLabel="Frete" Style="text-align:right">
                    @Format.Money(context.Item.FreteRateado, Entrada.MoedaFrete)
                </MudTd>
                <MudTd DataLabel="Impostos" Style="text-align:right">
                    @Format.Money(context.Item.ImpostoRateado, Entrada.MoedaImpostos)
                </MudTd>
                <MudTd DataLabel="Custo unit. (R$)" Style="text-align:right">
                    @Format.Money(context.Item.CustoUnitario)
                </MudTd>
                <MudTd DataLabel="Total (R$)" Style="text-align:right">@Format.Money(context.SubtotalBrl)</MudTd>
            </RowTemplate>
            <FooterContent>
                <MudTd></MudTd>
                <MudTd></MudTd>
                <MudTd Style="text-align:right"><b>Total</b></MudTd>
                <MudTd Style="text-align:right">
                    <b>@Format.Money(Entrada.TotalProdutos, Entrada.MoedaProdutos)</b>
                </MudTd>
                <MudTd></MudTd>
                <MudTd Style="text-align:right"><b>@Format.Money(Entrada.Frete, Entrada.MoedaFrete)</b></MudTd>
                <MudTd Style="text-align:right"><b>@Format.Money(Entrada.Impostos, Entrada.MoedaImpostos)</b></MudTd>
                <MudTd></MudTd>
                <MudTd Style="text-align:right"><b>@Format.Money(Entrada.TotalBrl)</b></MudTd>
            </FooterContent>
        </MudTable>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close" Color="Color.Primary" Variant="Variant.Filled">Fechar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public EntradaEstoque Entrada { get; set; } = default!;

    private IEnumerable<Linha> Linhas => Entrada.Itens.Select(item =>
    {
        var subtotal = item.Qtd * item.PrecoUnitario;
        return new Linha
        {
            Item = item,
            Subtotal = subtotal,
            Proporcao = EntradaCustoCalculator.Proporcao(
                subtotal,
                Entrada.TotalProdutos,
                item.Qtd,
                Entrada.Itens.Sum(i => i.Qtd)),
            SubtotalBrl = Entrada.SubtotalDestino(item)
        };
    });

    private void Close() => MudDialog.Close();

    private static string InsumoDetalhe(Insumo i)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(i.TipoInsumo?.Nome)) parts.Add(i.TipoInsumo.Nome);
        if (!string.IsNullOrWhiteSpace(i.Valor)) parts.Add(i.Valor!);
        if (!string.IsNullOrWhiteSpace(i.Potencia)) parts.Add(i.Potencia!);
        if (!string.IsNullOrWhiteSpace(i.Voltagem)) parts.Add(i.Voltagem!);
        return parts.Count == 0 ? "—" : string.Join(" · ", parts);
    }

    private sealed class Linha
    {
        public EntradaEstoqueItem Item { get; init; } = default!;
        public decimal Subtotal { get; init; }
        public decimal Proporcao { get; init; }
        public decimal SubtotalBrl { get; init; }
    }
}
