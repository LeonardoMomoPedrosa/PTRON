@inject InsumoService InsumoService
@inject ImageUploadService Images
@inject ISnackbar Snackbar

<MudDialog OnKeyUp="OnDialogKeyUp">
    <DialogContent>
            <MudForm @ref="_form" Model="_model" Class="equipamento-flow-dialog">
                <MudGrid>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.Nome"
                                  Label="Nome"
                                  Required="true"
                                  RequiredError="O nome é obrigatório."
                                  MaxLength="150"
                                  Immediate="true"
                                  DebounceInterval="0" />
                </MudItem>
                <MudItem xs="12">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="equipamento-photo-row">
                        <MudButton HtmlTag="label"
                                   Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Image"
                                   Disabled="_enviandoFoto"
                                   Class="equipamento-photo-trigger">
                            <InputFile @key="_photoInputKey"
                                       OnChange="OnPhotoSelected"
                                       accept=".jpg,.jpeg,.png,.gif,.webp,image/jpeg,image/png,image/gif,image/webp"
                                       class="equipamento-photo-file" />
                            @PhotoButtonText
                        </MudButton>
                        @if (!string.IsNullOrEmpty(_model.FotoPath))
                        {
                            <MudImage @key="_model.FotoPath" Src="@_model.FotoPath" Width="56" Height="56"
                                      ObjectFit="ObjectFit.Cover" Class="rounded" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                           Size="Size.Medium" aria-label="Remover foto" OnClick="RemovePhoto" />
                        }
                    </MudStack>
                    @if (!string.IsNullOrEmpty(_fotoErro))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Error" Class="mt-1">@_fotoErro</MudText>
                    }
                </MudItem>
            </MudGrid>

            <MudText Typo="Typo.subtitle1" Class="mt-4 mb-2">Insumos do equipamento</MudText>

            <MudGrid Class="align-end">
                <MudItem xs="12" sm="7">
                    <MudAutocomplete T="Insumo"
                                     @bind-Value="_novoInsumo"
                                     Label="Insumo"
                                     SearchFunc="SearchInsumos"
                                     ToStringFunc="@(i => i is null ? string.Empty : InsumoLabel(i))"
                                     ResetValueOnEmptyText="true"
                                     CoerceText="true"
                                     Clearable="true"
                                     PopoverFixed="true"
                                     MaxHeight="240"
                                     AnchorOrigin="Origin.BottomLeft"
                                     TransformOrigin="Origin.TopLeft">
                        <ItemTemplate Context="insumo">
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.body2">@insumo.Nome</MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                    @InsumoDetalhe(insumo)
                                    · saldo @Format.Number(insumo.Saldo)
                                    · @Format.Money(insumo.CustoUnitario)
                                </MudText>
                            </MudStack>
                        </ItemTemplate>
                    </MudAutocomplete>
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudNumericField T="decimal" @bind-Value="_novaQtd" Label="Qtd"
                                     Min="0" Step="1"
                                     Immediate="true" DebounceInterval="0" />
                </MudItem>
                <MudItem xs="12" sm="2">
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.Add" OnClick="AddInsumo" FullWidth="true"
                               Class="equipamento-add-insumo">
                        Add
                    </MudButton>
                </MudItem>
            </MudGrid>

            <div class="equipamentos-bom-phone mt-2">
                @if (_bom.Count == 0)
                {
                    <MudText Typo="Typo.body2">Nenhum insumo adicionado.</MudText>
                }
                else
                {
                    <MudPaper Class="equipamentos-bom-list" Elevation="0">
                        @foreach (var row in _bom)
                        {
                            <div class="equipamentos-bom-row">
                                <div class="equipamentos-bom-text">
                                    <span class="equipamentos-nome">@row.Insumo?.Nome</span>
                                    <span class="equipamentos-meta">@(row.Insumo?.TipoInsumo?.Nome ?? "—")</span>
                                    <span class="equipamentos-meta">@Especificacoes(row.Insumo) · @Format.Number(row.Qtd)</span>
                                </div>
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Size="Size.Large"
                                               Color="Color.Error"
                                               aria-label="@($"Remover {row.Insumo?.Nome}")"
                                               OnClick="@(() => RemoveRow(row))" />
                            </div>
                        }
                    </MudPaper>
                }
            </div>

            <MudTable Items="_bom" Dense="true" Hover="true" Class="mt-2 equipamentos-bom-desktop" Elevation="0" Breakpoint="Breakpoint.None">
                <HeaderContent>
                    <MudTh>Insumo</MudTh>
                    <MudTh>Tipo</MudTh>
                    <MudTh>Especificações</MudTh>
                    <MudTh Style="text-align:right">Custo unit.</MudTh>
                    <MudTh Style="text-align:right">Qtd</MudTh>
                    <MudTh Style="text-align:right"></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Insumo">@context.Insumo?.Nome</MudTd>
                    <MudTd DataLabel="Tipo">@(context.Insumo?.TipoInsumo?.Nome ?? "—")</MudTd>
                    <MudTd DataLabel="Especificações">@Especificacoes(context.Insumo)</MudTd>
                    <MudTd DataLabel="Custo unit." Style="text-align:right">
                        @(context.Insumo is null ? "—" : Format.Money(context.Insumo.CustoUnitario))
                    </MudTd>
                    <MudTd DataLabel="Qtd" Style="text-align:right">@Format.Number(context.Qtd)</MudTd>
                    <MudTd Style="text-align:right">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                       Color="Color.Error" OnClick="@(() => RemoveRow(context))" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Typo="Typo.body2">Nenhum insumo adicionado.</MudText>
                </NoRecordsContent>
            </MudTable>
            </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_enviandoFoto">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="_enviandoFoto" OnClick="Submit">
            @(_enviandoFoto ? "Enviando foto…" : "Salvar")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public Equipamento? Equipamento { get; set; }

    private MudForm _form = default!;
    private Equipamento _model = new();
    private List<EquipamentoInsumo> _bom = new();
    private List<Insumo> _insumos = new();

    private Insumo? _novoInsumo;
    private decimal _novaQtd = 1m;
    private string? _fotoOriginal;
    private string? _uploadedFoto;
    private string? _fotoErro;
    private bool _enviandoFoto;
    private int _photoInputKey;

    private string PhotoButtonText => _enviandoFoto
        ? "Enviando…"
        : string.IsNullOrEmpty(_model.FotoPath) ? "Selecionar foto" : "Trocar foto";

    protected override async Task OnInitializedAsync()
    {
        _insumos = await InsumoService.GetAllAsync();

        if (Equipamento is null)
        {
            _model = new Equipamento();
            _bom = new List<EquipamentoInsumo>();
        }
        else
        {
            _model = new Equipamento { Id = Equipamento.Id, Nome = Equipamento.Nome, FotoPath = Equipamento.FotoPath };
            _bom = Equipamento.Insumos
                .Select(ei => new EquipamentoInsumo
                {
                    InsumoId = ei.InsumoId,
                    Qtd = ei.Qtd,
                    Insumo = ei.Insumo ?? _insumos.FirstOrDefault(i => i.Id == ei.InsumoId)
                })
                .ToList();
        }

        _fotoOriginal = _model.FotoPath;
    }

    private Task<IEnumerable<Insumo>> SearchInsumos(string? value, CancellationToken token)
    {
        IEnumerable<Insumo> result = _insumos.Where(i => InsumoService.MatchesSearch(i, value));
        return Task.FromResult(result);
    }

    private static string InsumoLabel(Insumo i)
        => $"{i.Nome} · {InsumoDetalhe(i)} (saldo: {Format.Number(i.Saldo)} · {Format.Money(i.CustoUnitario)})";

    private static string InsumoDetalhe(Insumo i)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(i.TipoInsumo?.Nome)) parts.Add(i.TipoInsumo.Nome);
        if (!string.IsNullOrWhiteSpace(i.Valor)) parts.Add(i.Valor!);
        if (!string.IsNullOrWhiteSpace(i.Potencia)) parts.Add(i.Potencia!);
        if (!string.IsNullOrWhiteSpace(i.Voltagem)) parts.Add(i.Voltagem!);
        return parts.Count == 0 ? "—" : string.Join(" · ", parts);
    }

    private static string Especificacoes(Insumo? i)
    {
        if (i is null)
        {
            return "—";
        }

        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(i.Valor)) parts.Add(i.Valor!);
        if (!string.IsNullOrWhiteSpace(i.Potencia)) parts.Add(i.Potencia!);
        if (!string.IsNullOrWhiteSpace(i.Voltagem)) parts.Add(i.Voltagem!);
        return parts.Count == 0 ? "—" : string.Join(" · ", parts);
    }

    private void AddInsumo()
    {
        if (_novoInsumo is null)
        {
            Snackbar.Add("Selecione um insumo.", Severity.Warning);
            return;
        }

        if (_novaQtd <= 0)
        {
            Snackbar.Add("A quantidade deve ser maior que zero.", Severity.Warning);
            return;
        }

        var existing = _bom.FirstOrDefault(b => b.InsumoId == _novoInsumo.Id);
        if (existing is not null)
        {
            existing.Qtd += _novaQtd;
        }
        else
        {
            _bom.Add(new EquipamentoInsumo
            {
                InsumoId = _novoInsumo.Id,
                Qtd = _novaQtd,
                Insumo = _novoInsumo
            });
        }

        _novoInsumo = null;
        _novaQtd = 1m;
    }

    private void RemoveRow(EquipamentoInsumo row) => _bom.Remove(row);

    private async Task OnPhotoSelected(InputFileChangeEventArgs args)
    {
        var file = args.File;
        _photoInputKey++;
        if (file is null)
        {
            return;
        }

        _enviandoFoto = true;
        _fotoErro = null;
        try
        {
            var path = await Images.SaveAsync(file);
            DiscardPendingUpload();
            _uploadedFoto = path;
            _model.FotoPath = path;
        }
        catch (Exception ex)
        {
            _fotoErro = ex.Message;
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _enviandoFoto = false;
        }
    }

    private void RemovePhoto()
    {
        DiscardPendingUpload();
        _model.FotoPath = null;
        _fotoErro = null;
    }

    private void DiscardPendingUpload()
    {
        if (!string.IsNullOrEmpty(_uploadedFoto) && _uploadedFoto != _fotoOriginal)
        {
            Images.Delete(_uploadedFoto);
        }

        _uploadedFoto = null;
    }

    private async Task OnDialogKeyUp(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || _enviandoFoto)
        {
            return;
        }

        // Enter with an insumo selected adds a BOM line; otherwise saves the equipment.
        if (_novoInsumo is not null)
        {
            AddInsumo();
            return;
        }

        await Submit();
    }

    private async Task Submit()
    {
        if (_enviandoFoto)
        {
            return;
        }

        await _form.ValidateAsync();
        if (!_form.IsValid)
        {
            return;
        }

        _model.Insumos = _bom;
        MudDialog.Close(DialogResult.Ok(_model));
    }

    private void Cancel()
    {
        DiscardPendingUpload();
        MudDialog.Cancel();
    }
}
