<MudDialog>
    <DialogContent>
        <MudStack Spacing="2" Class="mb-4">
            <MudText><b>@L["Equipamento:"]</b> @Produto.Equipamento?.Nome</MudText>
            <MudText><b>@L["Data:"]</b> @Format.Date(Produto.Data)</MudText>
            <MudText>
                <b>@L["Descrição:"]</b>
                @(string.IsNullOrWhiteSpace(Produto.DescricaoAdicional) ? "—" : Produto.DescricaoAdicional)
            </MudText>
            <MudText><b>@L["Custo total:"]</b> @Format.Money(Produto.CustoTotal)</MudText>
        </MudStack>

        <MudText Typo="Typo.subtitle2" Class="mb-2">@L["Insumos consumidos (snapshot)"]</MudText>
        <MudTable Items="Produto.Insumos" Dense="true" Hover="true" Elevation="0">
            <HeaderContent>
                <MudTh>@L["Insumo"]</MudTh>
                <MudTh Style="text-align:right">@L["Qtd"]</MudTh>
                <MudTh Style="text-align:right">@L["Preço unit."]</MudTh>
                <MudTh Style="text-align:right">@L["Subtotal"]</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@L["Insumo"]">@context.Insumo?.Nome</MudTd>
                <MudTd DataLabel="@L["Qtd"]" Style="text-align:right">@Format.Number(context.Qtd)</MudTd>
                <MudTd DataLabel="@L["Preço unit."]" Style="text-align:right">@Format.Money(context.PrecoUnitario)</MudTd>
                <MudTd DataLabel="@L["Subtotal"]" Style="text-align:right">
                    @Format.Money(context.Qtd * context.PrecoUnitario)
                </MudTd>
            </RowTemplate>
            <FooterContent>
                <MudTd></MudTd>
                <MudTd></MudTd>
                <MudTd Style="text-align:right"><b>@L["Total"]</b></MudTd>
                <MudTd Style="text-align:right"><b>@Format.Money(Produto.CustoTotal)</b></MudTd>
            </FooterContent>
            <NoRecordsContent>
                <MudText>@L["Nenhum insumo registrado."]</MudText>
            </NoRecordsContent>
        </MudTable>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close" Color="Color.Primary" Variant="Variant.Filled">@L["Fechar"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public Produto Produto { get; set; } = default!;

    private void Close() => MudDialog.Close();
}
