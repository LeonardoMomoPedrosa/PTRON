<svg class="flag-icon" viewBox="0 0 30 20" width="@Width" height="@(Width * 2 / 3)" aria-hidden="true" focusable="false">
    @switch (Code)
    {
        case "pt-BR":
            <rect width="30" height="20" fill="#009c3b" />
            <polygon points="15,2.5 27,10 15,17.5 3,10" fill="#ffdf00" />
            <circle cx="15" cy="10" r="4.2" fill="#002776" />
            break;
        case "en":
            <rect width="30" height="20" fill="#012169" />
            <path d="M0,0 L30,20 M30,0 L0,20" stroke="#fff" stroke-width="4" />
            <path d="M0,0 L30,20 M30,0 L0,20" stroke="#C8102E" stroke-width="2.4" />
            <path d="M15,0 V20 M0,10 H30" stroke="#fff" stroke-width="6.67" />
            <path d="M15,0 V20 M0,10 H30" stroke="#C8102E" stroke-width="4" />
            break;
        case "es":
            <rect width="30" height="20" fill="#aa151b" />
            <rect y="5" width="30" height="10" fill="#f1bf00" />
            break;
    }
    <rect width="30" height="20" fill="none" stroke="rgba(0,0,0,.25)" />
</svg>

@code {
    [Parameter] public string Code { get; set; } = "";
    [Parameter] public int Width { get; set; } = 24;
}
