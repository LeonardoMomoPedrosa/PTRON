@inherits LayoutComponentBase

<MudThemeProvider Theme="PtronTheme.Theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="welcome-shell">
    <header class="welcome-bar">
        <div class="welcome-brand-row">
            <a href="/" class="welcome-brand" aria-label="Makelectron">
                <BrandLogo Height="32" />
            </a>
            <span class="beta-mark">Beta</span>
        </div>
        <nav class="welcome-bar-actions" aria-label="Conta">
            <LanguageSelector />
            <MudButton Href="/login" Variant="Variant.Outlined" Color="Color.Primary">Entrar</MudButton>
            <MudButton Href="/cadastro" Variant="Variant.Filled" Color="Color.Primary">Criar conta</MudButton>
        </nav>
    </header>
    @Body
</div>
