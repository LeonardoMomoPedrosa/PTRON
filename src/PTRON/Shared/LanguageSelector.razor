@using System.Globalization
@inject NavigationManager Navigation

<MudMenu Color="Color.Inherit" AriaLabel="@L["Escolher idioma"]"
         AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
    <ActivatorContent>
        <MudButton Color="Color.Inherit" Class="language-button" aria-label="@L["Escolher idioma"]">
            <FlagIcon Code="@_current.Code" Width="22" />
            <span lang="@_current.Code" class="ml-2">@_current.Name</span>
        </MudButton>
    </ActivatorContent>
    <ChildContent>
        @foreach (var language in SupportedLanguages.All)
        {
            <MudMenuItem OnClick="@(() => Select(language))"
                         Class="@(language.Code == _current.Code ? "mud-selected-item" : null)">
                <span class="d-inline-flex align-center">
                    <FlagIcon Code="@language.Code" Width="22" />
                    <span lang="@language.Code" class="ml-2">@language.Name</span>
                </span>
            </MudMenuItem>
        }
    </ChildContent>
</MudMenu>

@code {
    private Language _current = SupportedLanguages.Current;

    private void Select(Language language)
    {
        var retorno = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
        Navigation.NavigateTo(
            $"/idioma?cultura={Uri.EscapeDataString(language.Code)}&retorno={Uri.EscapeDataString(retorno)}",
            forceLoad: true);
    }
}
