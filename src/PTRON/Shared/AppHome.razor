@using Microsoft.AspNetCore.Components.Authorization
@using PTRON.Identity
@using PTRON.Services
@inject SignupDashboardService Signups

<PageTitle>Makelectron — Início</PageTitle>

<BrandLogo Height="64" />
<MudText Typo="Typo.subtitle1" Class="mt-3 mb-6">
    Controle de produção de equipamentos eletrônicos.
</MudText>

<MudGrid>
    @if (_signups is not null)
    {
        <MudItem xs="12">
            <MudCard Class="pa-2">
                <MudCardContent>
                    <MudIcon Icon="@Icons.Material.Filled.People" Color="Color.Primary" Size="Size.Large" />
                    <MudText Typo="Typo.h6" Class="mt-2">Usuários cadastrados</MudText>
                    <MudText Typo="Typo.h4">@_signups.Cadastrados</MudText>
                    <MudText Typo="Typo.body2">@Detalhe</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
    }
    @foreach (var item in _atalhos)
    {
        <MudItem xs="12" sm="6" md="4">
            <MudCard Class="pa-2" Style="height:100%">
                <MudCardContent>
                    <MudIcon Icon="@item.Icon" Color="Color.Primary" Size="Size.Large" />
                    <MudText Typo="Typo.h6" Class="mt-2">@item.Titulo</MudText>
                    <MudText Typo="Typo.body2">@item.Descricao</MudText>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Href="@item.Href" Variant="Variant.Text" Color="Color.Primary">Abrir</MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
    }
    @if (_reserved)
    {
        <MudItem xs="12" sm="6" md="4">
            <MudCard Class="pa-2" Style="height:100%">
                <MudCardContent>
                    <MudIcon Icon="@Icons.Material.Filled.Storage" Color="Color.Primary" Size="Size.Large" />
                    <MudText Typo="Typo.h6" Class="mt-2">SQL</MudText>
                    <MudText Typo="Typo.body2">Consultas e comandos diretos no banco.</MudText>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Href="sql" Variant="Variant.Text" Color="Color.Primary">Abrir</MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
    }
</MudGrid>

@code {
    private record Atalho(string Titulo, string Descricao, string Href, string Icon);

    private readonly Atalho[] _atalhos =
    {
        new("Tipos", "Tipos de componente (resistor, diodo...).", "tipos", Icons.Material.Filled.Category),
        new("Insumos", "Componentes com saldo e custo.", "insumos", Icons.Material.Filled.Memory),
        new("Equipamentos", "Modelos e suas listas de insumos.", "equipamentos", Icons.Material.Filled.DeveloperBoard),
        new("Entrada de estoque", "Compra de insumos com custo médio.", "entradas", Icons.Material.Filled.AddShoppingCart),
        new("Produção", "Produzir a partir de um modelo.", "producao", Icons.Material.Filled.PrecisionManufacturing),
        new("Produtos", "Produtos produzidos e custos.", "produtos", Icons.Material.Filled.Inventory2),
    };

    private bool _reserved;
    private SignupCounts? _signups;

    private string Detalhe
    {
        get
        {
            if (_signups is null || _signups.Cadastrados == 0)
                return "Ninguém se cadastrou ainda.";

            var pendentes = _signups.Cadastrados - _signups.Ativos;
            if (pendentes == 0)
                return "Todos já ativaram a conta.";

            return $"{FraseAtivos(_signups.Ativos)} {FrasePendentes(pendentes)}";
        }
    }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is null)
            return;

        _reserved = ReservedUsers.IsReservedPrincipal((await AuthState).User);
        if (_reserved)
            _signups = await Signups.GetAsync();
    }

    private static string FraseAtivos(int n) => n == 1
        ? "1 já ativou a conta."
        : $"{n} já ativaram a conta.";

    private static string FrasePendentes(int n) => n == 1
        ? "1 ainda aguarda o e-mail."
        : $"{n} ainda aguardam o e-mail.";
}
