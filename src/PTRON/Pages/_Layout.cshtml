@using Microsoft.AspNetCore.Components.Web
@namespace PTRON.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@inject Microsoft.Extensions.Localization.IStringLocalizer<PTRON.SharedResource> L

<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Makelectron</title>
    <base href="~/" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <link rel="apple-touch-icon" href="apple-touch-icon.png" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link href="css/site.css" rel="stylesheet" asp-append-version="true" />
    <link href="PTRON.styles.css" rel="stylesheet" asp-append-version="true" />
    <component type="typeof(HeadOutlet)" render-mode="ServerPrerendered" />
</head>
<body>
    @RenderBody()

    <div id="blazor-error-ui">
        <environment include="Staging,Production">
            @L["Ocorreu um erro. O aplicativo pode parar de responder até ser recarregado."]
        </environment>
        <environment include="Development">
            @L["Ocorreu uma exceção não tratada. Veja as ferramentas do navegador para detalhes."]
        </environment>
        <a href="" class="reload">@L["Recarregar"]</a>
        <a class="dismiss">🗙</a>
    </div>

    <div id="components-reconnect-modal">
        <div class="reconnect-box">
            <p class="reconnect-pending">@L["Conectando ao servidor novamente…"]</p>
            <p class="reconnect-failed">@L["Não foi possível reconectar."] <a href="">@L["Recarregar"]</a></p>
        </div>
    </div>

    <persist-component-state />
    <script src="_framework/blazor.server.js" autostart="false"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script>
        Blazor.start({
            configureSignalR: function (builder) {
                builder.withServerTimeout(300000).withKeepAliveInterval(15000);
            },
            reconnectionOptions: {
                maxRetries: 720,
                retryIntervalMilliseconds: function (previousAttempts) {
                    if (previousAttempts < 10) return 500;
                    if (previousAttempts < 25) return 2000;
                    return 5000;
                }
            }
        });

        // Retry as soon as the user comes back instead of waiting for the next interval.
        document.addEventListener("visibilitychange", function () {
            var modal = document.getElementById("components-reconnect-modal");
            if (document.visibilityState === "visible" && modal &&
                modal.classList.contains("components-reconnect-failed")) {
                Blazor.reconnect().catch(function () {});
            }
        });
    </script>
</body>
</html>
