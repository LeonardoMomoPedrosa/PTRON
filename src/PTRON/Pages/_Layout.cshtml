@using Microsoft.AspNetCore.Components.Web
@namespace PTRON.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="~/" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link href="css/site.css" rel="stylesheet" />
    <link href="PTRON.styles.css" rel="stylesheet" />
    <component type="typeof(HeadOutlet)" render-mode="ServerPrerendered" />
</head>
<body>
    @RenderBody()

    <div id="blazor-error-ui">
        <environment include="Staging,Production">
            An error has occurred. This application may no longer respond until reloaded.
        </environment>
        <environment include="Development">
            An unhandled exception has occurred. See browser dev tools for details.
        </environment>
        <a href="" class="reload">Reload</a>
        <a class="dismiss">🗙</a>
    </div>

    <div id="components-reconnect-modal">
        <div class="reconnect-box">
            <p class="reconnect-pending">Conectando ao servidor novamente…</p>
            <p class="reconnect-failed">Não foi possível reconectar. <a href="">Recarregar</a></p>
        </div>
    </div>

    <script src="_framework/blazor.server.js" autostart="false"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script>
        Blazor.start({
            configureSignalR: function (builder) {
                builder.withServerTimeout(120000).withKeepAliveInterval(15000);
            },
            reconnectionOptions: {
                maxRetries: 40,
                retryIntervalMilliseconds: function (previousAttempts) {
                    if (previousAttempts < 10) return 500;
                    if (previousAttempts < 25) return 2000;
                    return 5000;
                }
            }
        });
    </script>
</body>
</html>
