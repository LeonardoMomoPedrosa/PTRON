@page "/producao"
@inject ProducaoService ProducaoService
@inject EquipamentoService EquipamentoService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>@L["Produção — Makelectron"]</PageTitle>

<SeoMeta 
    Title="@L["Produção — Makelectron"]"
    Description="@L["Registre a produção de equipamentos e calcule custos automaticamente"]"
    NoIndex="true"
    NoFollow="true"
/>

<MudText Typo="Typo.h5" Class="mb-4">@L["Produção"]</MudText>

<MudPaper Class="pa-4 mb-4" Outlined="true">
    <MudGrid>
        <MudItem xs="12" md="5">
            <MudSelect T="int?" @bind-Value="_equipamentoId" @bind-Value:after="OnEquipamentoChanged"
                       Label="@L["Equipamento (modelo)"]"
                       Clearable="true"
                       AnchorOrigin="Origin.BottomCenter">
                @foreach (var eq in _equipamentos)
                {
                    <MudSelectItem T="int?" Value="eq.Id">@eq.Nome</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="4" md="2">
            <MudNumericField T="int" @bind-Value="_quantidade" @bind-Value:after="OnQuantidadeChanged"
                             Label="@L["Quantidade"]"
                             Min="1" Max="10000" Step="1"
                             HelperText="@L["Quantos produtos produzir"]"
                             Immediate="true" HideSpinButtons="false" />
        </MudItem>
        <MudItem xs="12" md="5">
            <MudTextField @bind-Value="_descricao"
                          Label="@L["Descrição adicional do produto"]"
                          MaxLength="1000"
                          Immediate="true"
                          HelperText="@L["Ex.: número de série, lote, observação"]" />
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_preview is null)
{
    <MudAlert Severity="Severity.Info">@L["Selecione um equipamento para revisar os insumos e o custo estimado."]</MudAlert>
}
else if (_preview.Linhas.Count == 0)
{
    <MudAlert Severity="Severity.Warning">
        @L["O equipamento \"{0}\" não possui insumos cadastrados na BOM.", _preview.EquipamentoNome]
    </MudAlert>
}
else
{
    @if (!_preview.PodeProduzir && _concluida)
    {
        <MudAlert Severity="Severity.Success" Class="mb-4" Dense="true">
            @(_preview.Quantidade == 1
                ? L["Produção concluída. O estoque agora não cobre outra leva de 1 unidade."]
                : L["Produção concluída. O estoque agora não cobre outra leva de {0} unidades.", _preview.Quantidade])
        </MudAlert>
    }
    else if (!_preview.PodeProduzir && !_preview.TemCustosCustomizados)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4" Dense="true">
            <MudText Typo="Typo.subtitle2">
                @(_preview.Quantidade == 1
                    ? L["Não é possível produzir — insumos faltantes:"]
                    : L["Não é possível produzir {0} unidades — insumos faltantes:", _preview.Quantidade])
            </MudText>
            <ul class="mt-2 mb-0">
                @foreach (var f in _preview.Faltantes)
                {
                    <li>
                        <b>@f.InsumoNome</b>@DetalheSuffix(f): @L["necessário {0}, disponível {1} (falta {2})", Format.Number(f.QtdNecessaria), Format.Number(f.SaldoDisponivel), Format.Number(f.Faltante)]
                    </li>
                }
            </ul>
            <MudText Typo="Typo.body2" Class="mt-3">
                @L["💡 Você pode inserir custos customizados abaixo para estimar o custo de pré-venda."]
            </MudText>
        </MudAlert>
    }
    else if (_preview.TemCustosCustomizados)
    {
        <MudAlert Severity="Severity.Info" Class="mb-4" Dense="true">
            <MudText Typo="Typo.subtitle2">
                @L["Modo de Prévia — Estimativa de Custo para Pré-Venda"]
            </MudText>
            <MudText Typo="Typo.body2" Class="mt-2">
                @(_preview.Quantidade == 1
                    ? L["Custo estimado com valores customizados:"]
                    : L["Custo estimado para {0} unidades com valores customizados:", _preview.Quantidade])
                <b>@Format.Money(_preview.CustoEstimado)</b>
                @if (_preview.Quantidade > 1)
                {
                    <text> (@L["Custo por unidade:"] <b>@Format.Money(_preview.CustoPorUnidade)</b>)</text>
                }
            </MudText>
            <MudText Typo="Typo.caption" Class="mt-2 mud-text-secondary">
                @L["⚠️ Esta é apenas uma estimativa. Produção não está disponível com custos customizados."]
            </MudText>
        </MudAlert>
    }
    else
    {
        <MudAlert Severity="Severity.Success" Class="mb-4" Dense="true">
            @if (_preview.Quantidade == 1)
            {
                <span>@L["Todos os insumos estão disponíveis. Custo estimado:"] <b>@Format.Money(_preview.CustoEstimado)</b></span>
            }
            else
            {
                <span>
                    @L["Todos os insumos estão disponíveis para {0} unidades.", _preview.Quantidade]
                    @L["Custo de cada uma:"] <b>@Format.Money(_preview.CustoPorUnidade)</b>.
                    @L["Custo das {0}:", _preview.Quantidade] <b>@Format.Money(_preview.CustoEstimado)</b>.
                </span>
            }
        </MudAlert>
    }

    <MudPaper Class="mb-4">
        <MudTable Items="_preview.Linhas" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh>@L["Insumo"]</MudTh>
                <MudTh Style="text-align:right">@L["Necessário"]</MudTh>
                <MudTh Style="text-align:right">@L["Disponível"]</MudTh>
                <MudTh Style="text-align:right">@L["Custo unit."]</MudTh>
                <MudTh Style="text-align:right">@L["Subtotal"]</MudTh>
                <MudTh Style="text-align:center">@L["Status"]</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@L["Insumo"]">
                    @context.InsumoNome
                    @if (!string.IsNullOrEmpty(context.InsumoDetalhe))
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@context.InsumoDetalhe</MudText>
                    }
                    @if (!context.Disponivel)
                    {
                        <MudText Typo="Typo.caption" Class="mud-error-text">
                            @L["Falta {0}", Format.Number(context.Faltante)]
                        </MudText>
                    }
                </MudTd>
                <MudTd DataLabel="@L["Necessário"]" Style="text-align:right">
                    @Format.Number(context.QtdNecessaria)
                    @if (_preview.Quantidade > 1)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            @_preview.Quantidade × @Format.Number(context.QtdPorUnidade)
                        </MudText>
                    }
                </MudTd>
                <MudTd DataLabel="@L["Disponível"]" Style="text-align:right"
                       Class="@(context.Disponivel ? null : "mud-error-text")">
                    @Format.Number(context.SaldoDisponivel)
                </MudTd>
                <MudTd DataLabel="@L["Custo unit."]" Style="text-align:right">
                    @if (!context.Disponivel)
                    {
                        <MudNumericField T="decimal?"
                                         @bind-Value="context.CustoCustomizado"
                                         @bind-Value:after="StateHasChanged"
                                         Label="@L["Custo estimado"]"
                                         Placeholder="@Format.Money(context.CustoUnitario)"
                                         Min="0"
                                         Step="0.01m"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Clearable="true"
                                         HideSpinButtons="true"
                                         Adornment="Adornment.Start"
                                         AdornmentIcon="@Icons.Material.Filled.AttachMoney" />
                        @if (context.CustoCustomizado.HasValue)
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                @L["Original:"] @Format.Money(context.CustoUnitario)
                            </MudText>
                        }
                    }
                    else
                    {
                        @Format.Money(context.CustoUnitario)
                    }
                </MudTd>
                <MudTd DataLabel="@L["Subtotal"]" Style="text-align:right">
                    @Format.Money(context.Subtotal)
                    @if (context.CustoCustomizado.HasValue)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Preview" Color="Color.Info" Size="Size.Small" Title="@L["Custo customizado"]" />
                    }
                </MudTd>
                <MudTd DataLabel="@L["Status"]" Style="text-align:center">
                    @if (context.Disponivel)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                    }
                    else if (context.CustoCustomizado.HasValue)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Calculate" Color="Color.Info" Size="Size.Small" Title="@L["Prévia"]" />
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Error" Color="Color.Error" Size="Size.Small" />
                    }
                </MudTd>
            </RowTemplate>
            <FooterContent>
                <MudTd></MudTd>
                <MudTd></MudTd>
                <MudTd></MudTd>
                <MudTd Style="text-align:right">
                    <b>
                        @if (_preview.TemCustosCustomizados)
                        {
                            @(_preview.Quantidade == 1 ? L["Prévia de custo"] : L["Prévia de custo de {0}", _preview.Quantidade])
                        }
                        else
                        {
                            @(_preview.Quantidade == 1 ? L["Custo estimado"] : L["Custo de {0}", _preview.Quantidade])
                        }
                    </b>
                </MudTd>
                <MudTd Style="text-align:right">
                    <b>@Format.Money(_preview.CustoEstimado)</b>
                    @if (_preview.TemCustosCustomizados)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Preview" Color="Color.Info" Size="Size.Small" />
                    }
                </MudTd>
                <MudTd></MudTd>
            </FooterContent>
        </MudTable>
    </MudPaper>

    <MudStack Row="true" Justify="Justify.FlexEnd">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.PrecisionManufacturing"
                   Disabled="@(!_preview.PodeProduzir || _produzindo || _carregandoPreview || _quantidade < 1)"
                   OnClick="Produzir">
            @(_quantidade == 1 ? L["Produzir"] : L["Produzir {0}", _quantidade])
        </MudButton>
    </MudStack>
}

@code {
    private static string DetalheSuffix(BomLinhaPreview linha)
        => string.IsNullOrEmpty(linha.InsumoDetalhe) ? string.Empty : $" ({linha.InsumoDetalhe})";

    private List<Equipamento> _equipamentos = new();
    private int? _equipamentoId;
    private int _quantidade = 1;
    private string? _descricao;
    private ProducaoPreview? _preview;
    private bool _produzindo;
    private bool _carregandoPreview;
    private bool _concluida;
    private int _previewTicket;

    protected override async Task OnInitializedAsync()
    {
        _equipamentos = await EquipamentoService.GetAllAsync();
    }

    private Task OnEquipamentoChanged()
    {
        _concluida = false;
        return LoadPreview();
    }

    private Task OnQuantidadeChanged()
    {
        _concluida = false;
        if (_quantidade < 1)
        {
            _quantidade = 1;
        }

        return LoadPreview();
    }

    private async Task LoadPreview()
    {
        var ticket = ++_previewTicket;
        var id = _equipamentoId;
        var quantidade = Math.Max(1, _quantidade);
        if (id is null)
        {
            _preview = null;
            _carregandoPreview = false;
            return;
        }

        _carregandoPreview = true;
        try
        {
            var preview = await ProducaoService.GetPreviewAsync(id.Value, quantidade);
            if (ticket == _previewTicket)
            {
                _preview = preview;
            }
        }
        finally
        {
            if (ticket == _previewTicket)
            {
                _carregandoPreview = false;
            }
        }
    }

    private async Task Produzir()
    {
        if (_preview is null || !_preview.PodeProduzir)
        {
            return;
        }

        var unidades = _quantidade == 1 ? L["1 unidade"].Value : L["{0} unidades", _quantidade].Value;
        var custo = _quantidade == 1
            ? L["custo estimado de {0}", Format.Money(_preview.CustoEstimado)].Value
            : L["custo de {0} cada ({1} no total)", Format.Money(_preview.CustoPorUnidade), Format.Money(_preview.CustoEstimado)].Value;
        var parameters = new DialogParameters<ConfirmDialog>
        {
            {
                x => x.Message,
                L["Produzir {0} de \"{1}\" com {2}? Os insumos serão subtraídos do estoque.", unidades, _preview.EquipamentoNome, custo]
            },
            { x => x.ConfirmText, L["Produzir"] },
            { x => x.Color, Color.Primary }
        };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>(L["Confirmar produção"], parameters);
        var result = await dialog.Result;
        if (result is { Canceled: true })
        {
            return;
        }

        _produzindo = true;
        try
        {
            var resultado = await ProducaoService.ProduzirAsync(
                _preview.EquipamentoId, _descricao, _quantidade);
            var mensagem = resultado.Quantidade == 1
                ? L["Produto #{0} criado. Custo total: {1}.", resultado.Produtos[0].Id, Format.Money(resultado.CustoUnitario)].Value
                : L["{0} produtos criados. Custo de cada um: {1}.", resultado.Quantidade, Format.Money(resultado.CustoUnitario)].Value;
            Snackbar.Add(mensagem, Severity.Success);

            _descricao = null;
            _concluida = true;
            await LoadPreview();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            await LoadPreview();
        }
        finally
        {
            _produzindo = false;
        }
    }
}
