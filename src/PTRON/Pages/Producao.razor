@page "/producao"
@inject ProducaoService ProducaoService
@inject EquipamentoService EquipamentoService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Produção</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">Produção</MudText>

<MudPaper Class="pa-4 mb-4" Outlined="true">
    <MudGrid>
        <MudItem xs="12" md="5">
            <MudSelect T="int?" @bind-Value="_equipamentoId" @bind-Value:after="OnEquipamentoChanged"
                       Label="Equipamento (modelo)"
                       Clearable="true"
                       AnchorOrigin="Origin.BottomCenter">
                @foreach (var eq in _equipamentos)
                {
                    <MudSelectItem T="int?" Value="eq.Id">@eq.Nome</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="4" md="2">
            <MudNumericField T="int" @bind-Value="_quantidade" @bind-Value:after="OnQuantidadeChanged"
                             Label="Quantidade"
                             Min="1" Max="10000" Step="1"
                             HelperText="Quantos produtos produzir"
                             Immediate="true" HideSpinButtons="false" />
        </MudItem>
        <MudItem xs="12" md="5">
            <MudTextField @bind-Value="_descricao"
                          Label="Descrição adicional do produto"
                          MaxLength="1000"
                          Immediate="true"
                          HelperText="Ex.: número de série, lote, observação" />
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_preview is null)
{
    <MudAlert Severity="Severity.Info">Selecione um equipamento para revisar os insumos e o custo estimado.</MudAlert>
}
else if (_preview.Linhas.Count == 0)
{
    <MudAlert Severity="Severity.Warning">
        O equipamento "@_preview.EquipamentoNome" não possui insumos cadastrados na BOM.
    </MudAlert>
}
else
{
    @if (!_preview.PodeProduzir && _concluida)
    {
        <MudAlert Severity="Severity.Success" Class="mb-4" Dense="true">
            Produção concluída. O estoque agora não cobre outra leva de @_preview.Quantidade
            @(_preview.Quantidade == 1 ? "unidade" : "unidades").
        </MudAlert>
    }
    else if (!_preview.PodeProduzir)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4" Dense="true">
            <MudText Typo="Typo.subtitle2">
                Não é possível produzir@(_preview.Quantidade == 1 ? "" : $" {_preview.Quantidade} unidades") — insumos faltantes:
            </MudText>
            <ul class="mt-2 mb-0">
                @foreach (var f in _preview.Faltantes)
                {
                    <li>
                        <b>@f.InsumoNome</b>@DetalheSuffix(f): necessário @Format.Number(f.QtdNecessaria),
                        disponível @Format.Number(f.SaldoDisponivel)
                        (falta @Format.Number(f.Faltante))
                    </li>
                }
            </ul>
        </MudAlert>
    }
    else
    {
        <MudAlert Severity="Severity.Success" Class="mb-4" Dense="true">
            @if (_preview.Quantidade == 1)
            {
                <span>Todos os insumos estão disponíveis. Custo estimado: <b>@Format.Money(_preview.CustoEstimado)</b></span>
            }
            else
            {
                <span>
                    Todos os insumos estão disponíveis para @_preview.Quantidade unidades.
                    Custo de cada uma: <b>@Format.Money(_preview.CustoPorUnidade)</b>.
                    Custo das @_preview.Quantidade: <b>@Format.Money(_preview.CustoEstimado)</b>.
                </span>
            }
        </MudAlert>
    }

    <MudPaper Class="mb-4">
        <MudTable Items="_preview.Linhas" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh>Insumo</MudTh>
                <MudTh Style="text-align:right">Necessário</MudTh>
                <MudTh Style="text-align:right">Disponível</MudTh>
                <MudTh Style="text-align:right">Custo unit.</MudTh>
                <MudTh Style="text-align:right">Subtotal</MudTh>
                <MudTh Style="text-align:center">Status</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Insumo">
                    @context.InsumoNome
                    @if (!string.IsNullOrEmpty(context.InsumoDetalhe))
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@context.InsumoDetalhe</MudText>
                    }
                </MudTd>
                <MudTd DataLabel="Necessário" Style="text-align:right">
                    @Format.Number(context.QtdNecessaria)
                    @if (_preview.Quantidade > 1)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            @_preview.Quantidade × @Format.Number(context.QtdPorUnidade)
                        </MudText>
                    }
                </MudTd>
                <MudTd DataLabel="Disponível" Style="text-align:right"
                       Class="@(context.Disponivel ? null : "mud-error-text")">
                    @Format.Number(context.SaldoDisponivel)
                </MudTd>
                <MudTd DataLabel="Custo unit." Style="text-align:right">@Format.Money(context.CustoUnitario)</MudTd>
                <MudTd DataLabel="Subtotal" Style="text-align:right">@Format.Money(context.Subtotal)</MudTd>
                <MudTd DataLabel="Status" Style="text-align:center">
                    @if (context.Disponivel)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                    }
                    else
                    {
                        <MudChip T="string" Color="Color.Error" Size="Size.Small">
                            Falta @Format.Number(context.Faltante)
                        </MudChip>
                    }
                </MudTd>
            </RowTemplate>
            <FooterContent>
                <MudTd></MudTd>
                <MudTd></MudTd>
                <MudTd></MudTd>
                <MudTd Style="text-align:right"><b>@(_preview.Quantidade == 1 ? "Custo estimado" : $"Custo de {_preview.Quantidade}")</b></MudTd>
                <MudTd Style="text-align:right"><b>@Format.Money(_preview.CustoEstimado)</b></MudTd>
                <MudTd></MudTd>
            </FooterContent>
        </MudTable>
    </MudPaper>

    <MudStack Row="true" Justify="Justify.FlexEnd">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.PrecisionManufacturing"
                   Disabled="@(!_preview.PodeProduzir || _produzindo || _carregandoPreview || _quantidade < 1)"
                   OnClick="Produzir">
            @(_quantidade == 1 ? "Produzir" : $"Produzir {_quantidade}")
        </MudButton>
    </MudStack>
}

@code {
    private static string DetalheSuffix(BomLinhaPreview linha)
        => string.IsNullOrEmpty(linha.InsumoDetalhe) ? string.Empty : $" ({linha.InsumoDetalhe})";

    private List<Equipamento> _equipamentos = new();
    private int? _equipamentoId;
    private int _quantidade = 1;
    private string? _descricao;
    private ProducaoPreview? _preview;
    private bool _produzindo;
    private bool _carregandoPreview;
    private bool _concluida;
    private int _previewTicket;

    protected override async Task OnInitializedAsync()
    {
        _equipamentos = await EquipamentoService.GetAllAsync();
    }

    private Task OnEquipamentoChanged()
    {
        _concluida = false;
        return LoadPreview();
    }

    private Task OnQuantidadeChanged()
    {
        _concluida = false;
        if (_quantidade < 1)
        {
            _quantidade = 1;
        }

        return LoadPreview();
    }

    private async Task LoadPreview()
    {
        var ticket = ++_previewTicket;
        var id = _equipamentoId;
        var quantidade = Math.Max(1, _quantidade);
        if (id is null)
        {
            _preview = null;
            _carregandoPreview = false;
            return;
        }

        _carregandoPreview = true;
        try
        {
            var preview = await ProducaoService.GetPreviewAsync(id.Value, quantidade);
            if (ticket == _previewTicket)
            {
                _preview = preview;
            }
        }
        finally
        {
            if (ticket == _previewTicket)
            {
                _carregandoPreview = false;
            }
        }
    }

    private async Task Produzir()
    {
        if (_preview is null || !_preview.PodeProduzir)
        {
            return;
        }

        var unidades = _quantidade == 1 ? "1 unidade" : $"{_quantidade} unidades";
        var custo = _quantidade == 1
            ? $"custo estimado de {Format.Money(_preview.CustoEstimado)}"
            : $"custo de {Format.Money(_preview.CustoPorUnidade)} cada ({Format.Money(_preview.CustoEstimado)} no total)";
        var parameters = new DialogParameters<ConfirmDialog>
        {
            {
                x => x.Message,
                $"Produzir {unidades} de \"{_preview.EquipamentoNome}\" com {custo}? Os insumos serão subtraídos do estoque."
            },
            { x => x.ConfirmText, "Produzir" },
            { x => x.Color, Color.Primary }
        };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Confirmar produção", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: true })
        {
            return;
        }

        _produzindo = true;
        try
        {
            var resultado = await ProducaoService.ProduzirAsync(
                _preview.EquipamentoId, _descricao, _quantidade);
            var mensagem = resultado.Quantidade == 1
                ? $"Produto #{resultado.Produtos[0].Id} criado. Custo total: {Format.Money(resultado.CustoUnitario)}."
                : $"{resultado.Quantidade} produtos criados. Custo de cada um: {Format.Money(resultado.CustoUnitario)}.";
            Snackbar.Add(mensagem, Severity.Success);

            _descricao = null;
            _concluida = true;
            await LoadPreview();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            await LoadPreview();
        }
        finally
        {
            _produzindo = false;
        }
    }
}
