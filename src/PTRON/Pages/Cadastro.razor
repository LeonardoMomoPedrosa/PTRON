@page "/cadastro"
@layout LoginLayout
@attribute [AllowAnonymous]
@using System.ComponentModel.DataAnnotations
@using PTRON.Identity
@inject SignUpService SignUp

<PageTitle>@L["Makelectron — Criar conta"]</PageTitle>

<MudPaper Class="pa-6" Elevation="3">
    <div class="d-flex justify-center mb-4">
        <BrandLogo Height="56" />
    </div>

    @if (_done)
    {
        <MudText Typo="Typo.h6" Class="mb-2">@L["Verifique seu e-mail"]</MudText>
        <MudAlert Severity="Severity.Success" Class="mb-4">
            @L["Se o cadastro puder ser concluído, enviamos um link de ativação para"] <strong>@_model.Email</strong>.
            @L["Abra o e-mail e clique no link em até 24 horas para ativar sua conta."]
        </MudAlert>
        <MudText Typo="Typo.body2" Class="mb-4">
            @L["Não encontrou? Confira a caixa de spam. Você só consegue entrar depois de ativar a conta."]
        </MudText>
        <MudButton Href="/login" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large">
            @L["Ir para o login"]
        </MudButton>
    }
    else
    {
        <MudText Typo="Typo.h6" Class="mb-1">@L["Criar conta"]</MudText>
        <MudText Typo="Typo.body2" Class="mb-4">@L["Preencha os dados para se cadastrar."]</MudText>

        @if (_errors.Count > 0)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4" Dense="true">
                @foreach (var error in _errors)
                {
                    <div>@error</div>
                }
            </MudAlert>
        }

        <EditForm Model="_model" OnValidSubmit="SubmitAsync">
            <DataAnnotationsValidator />

            <MudTextField @bind-Value="_model.Email" For="() => _model.Email"
                          Label="@L["E-mail"]" InputType="InputType.Email" Variant="Variant.Outlined"
                          Class="mb-3" Immediate="true" autocomplete="email" MaxLength="@SignUpService.MaxEmailLength" />

            <MudSelect T="string" @bind-Value="_model.Pais" For="() => _model.Pais"
                       Label="@L["País"]" Variant="Variant.Outlined" Class="mb-3" Dense="true" MaxHeight="320">
                @foreach (var pais in Paises.Todos)
                {
                    <MudSelectItem T="string" Value="@pais.Codigo">@pais.Nome</MudSelectItem>
                }
            </MudSelect>

            <MudTextField @bind-Value="_model.Estado" For="() => _model.Estado"
                          Label="@L["Estado"]" Variant="Variant.Outlined" Class="mb-3"
                          MaxLength="@SignUpService.MaxEstadoLength" autocomplete="address-level1" />

            <MudTextField @bind-Value="_model.Senha" For="() => _model.Senha"
                          Label="@L["Senha"]" InputType="InputType.Password" Variant="Variant.Outlined"
                          HelperText="@L["Mínimo de 8 caracteres, com pelo menos uma letra e um número."]"
                          Class="mb-3" autocomplete="new-password" />

            <MudTextField @bind-Value="_model.ConfirmarSenha" For="() => _model.ConfirmarSenha"
                          Label="@L["Confirmar senha"]" InputType="InputType.Password" Variant="Variant.Outlined"
                          Class="mb-4" autocomplete="new-password" />

            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                       FullWidth="true" Size="Size.Large" Disabled="_busy">
                @L["Criar conta"]
            </MudButton>
        </EditForm>

        <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-4">
            @L["Já tem conta?"] <MudLink Href="/login">@L["Entrar"]</MudLink>
        </MudText>
    }
</MudPaper>

@code {
    private readonly CadastroModel _model = new();
    private List<string> _errors = new();
    private bool _busy;
    private bool _done;

    private async Task SubmitAsync()
    {
        if (_busy) return;
        _busy = true;
        _errors = new List<string>();
        try
        {
            var result = await SignUp.RegisterAsync(new SignUpRequest
            {
                Email = _model.Email,
                Pais = _model.Pais,
                Estado = _model.Estado,
                Idioma = SupportedLanguages.Current.Code,
                Senha = _model.Senha,
            });

            if (result.Succeeded)
                _done = true;
            else
                _errors = result.Errors.ToList();
        }
        catch (Exception)
        {
            _errors = new List<string> { L["Não foi possível concluir o cadastro. Tente novamente."].Value };
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class CadastroModel
    {
        [LRequired(ErrorMessage = "Informe o e-mail.")]
        [LEmail(ErrorMessage = "Informe um e-mail válido.")]
        [LStringLength(SignUpService.MaxEmailLength, ErrorMessage = "O e-mail é muito longo.")]
        public string? Email { get; set; }

        [LRequired(ErrorMessage = "Selecione o país.")]
        public string? Pais { get; set; }

        [LRequired(ErrorMessage = "Informe o estado.")]
        [LStringLength(SignUpService.MaxEstadoLength, ErrorMessage = "O estado deve ter no máximo 100 caracteres.")]
        public string? Estado { get; set; }

        [LRequired(ErrorMessage = "Informe a senha.")]
        [LMinLength(8, ErrorMessage = "A senha deve ter pelo menos 8 caracteres.")]
        public string? Senha { get; set; }

        [LRequired(ErrorMessage = "Confirme a senha.")]
        [LCompare(nameof(Senha), ErrorMessage = "As senhas não conferem.")]
        public string? ConfirmarSenha { get; set; }
    }
}
