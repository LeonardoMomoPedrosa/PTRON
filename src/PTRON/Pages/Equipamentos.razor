@page "/equipamentos"
@inject EquipamentoService EquipamentoService
@inject InsumoService InsumoService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>@L["Equipamentos"]</PageTitle>

<div class="equipamentos-page">
    <div class="equipamentos-toolbar mb-4">
        <MudText Typo="Typo.h5">@L["Equipamentos"]</MudText>
        <MudButton StartIcon="@Icons.Material.Filled.Add"
                   Color="Color.Primary"
                   Variant="Variant.Filled"
                   Class="equipamentos-add"
                   OnClick="OpenCreate">
            @L["Novo equipamento"]
        </MudButton>
    </div>

    <div class="equipamentos-phone">
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-2" />
        }
        else if (_equipamentos.Count == 0)
        {
            <MudPaper Class="pa-4">
                <MudText>@L["Nenhum equipamento cadastrado."]</MudText>
            </MudPaper>
        }
        else
        {
            <MudPaper Class="equipamentos-list" Elevation="1">
                @foreach (var equipamento in _equipamentos)
                {
                    <div class="equipamentos-row">
                        <div class="equipamentos-main">
                            @if (!string.IsNullOrEmpty(equipamento.FotoPath))
                            {
                                <img @key="equipamento.FotoPath" src="@equipamento.FotoPath" alt=""
                                     class="rounded equipamentos-foto" />
                            }
                            else
                            {
                                <span class="equipamentos-foto equipamentos-foto-empty">
                                    <MudIcon Icon="@Icons.Material.Filled.DeveloperBoard" />
                                </span>
                            }
                            <div class="equipamentos-text">
                                <span class="equipamentos-nome">@equipamento.Nome</span>
                                <span class="equipamentos-meta">@L["{0} insumos", equipamento.Insumos.Count]</span>
                            </div>
                        </div>
                        <span class="equipamentos-actions">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Size="Size.Large"
                                           Color="Color.Primary"
                                           aria-label="@L["Editar {0}", equipamento.Nome]"
                                           OnClick="@(() => OpenEdit(equipamento))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Size="Size.Large"
                                           Color="Color.Error"
                                           aria-label="@L["Excluir {0}", equipamento.Nome]"
                                           OnClick="@(() => Delete(equipamento))" />
                        </span>
                    </div>
                }
            </MudPaper>
        }
    </div>

    <MudPaper Class="equipamentos-desktop">
        <MudTable Items="_equipamentos"
                  Loading="_loading"
                  Hover="true"
                  Dense="true"
                  Breakpoint="Breakpoint.None"
                  LoadingProgressColor="Color.Primary">
            <HeaderContent>
                <MudTh Style="width:64px">@L["Foto"]</MudTh>
                <MudTh>@L["Nome"]</MudTh>
                <MudTh Style="text-align:right">@L["Insumos"]</MudTh>
                <MudTh Style="text-align:right">@L["Ações"]</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@L["Foto"]">
                    @if (!string.IsNullOrEmpty(context.FotoPath))
                    {
                        <img @key="context.FotoPath" src="@context.FotoPath" alt=""
                             class="rounded equipamentos-foto" />
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.DeveloperBoard" Color="Color.Default" />
                    }
                </MudTd>
                <MudTd DataLabel="@L["Nome"]">@context.Nome</MudTd>
                <MudTd DataLabel="@L["Insumos"]" Style="text-align:right">@context.Insumos.Count</MudTd>
                <MudTd DataLabel="@L["Ações"]" Style="text-align:right">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                   Color="Color.Primary"
                                   aria-label="@L["Editar {0}", context.Nome]"
                                   OnClick="@(() => OpenEdit(context))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                   Color="Color.Error"
                                   aria-label="@L["Excluir {0}", context.Nome]"
                                   OnClick="@(() => Delete(context))" />
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText>@L["Nenhum equipamento cadastrado."]</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>
</div>

@code {
    private static readonly DialogOptions DialogOptions = new()
    {
        MaxWidth = MaxWidth.Medium,
        FullWidth = true,
        CloseOnEscapeKey = true
    };

    private List<Equipamento> _equipamentos = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        _loading = true;
        _equipamentos = await EquipamentoService.GetAllAsync();
        _loading = false;
    }

    private async Task OpenCreate()
    {
        if ((await InsumoService.GetAllAsync()).Count == 0)
        {
            Snackbar.Add(L["Cadastre ao menos um insumo antes de criar equipamentos."], Severity.Warning);
            return;
        }

        var dialog = await DialogService.ShowAsync<EquipamentoDialog>(L["Novo equipamento"], DialogOptions);
        await dialog.Result;
        await Load();
    }

    private async Task OpenEdit(Equipamento equipamento)
    {
        var full = await EquipamentoService.GetWithBomAsync(equipamento.Id);
        if (full is null)
        {
            Snackbar.Add(L["Equipamento não encontrado."], Severity.Error);
            await Load();
            return;
        }

        var parameters = new DialogParameters<EquipamentoDialog> { { x => x.Equipamento, full } };
        var dialog = await DialogService.ShowAsync<EquipamentoDialog>(L["Editar equipamento"], parameters, DialogOptions);
        await dialog.Result;
        await Load();
    }

    private async Task Delete(Equipamento equipamento)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.Message, L["Excluir o equipamento \"{0}\" e sua lista de insumos?", equipamento.Nome] },
            { x => x.ConfirmText, L["Excluir"] },
            { x => x.MarkerClass, "equipamento-flow-dialog" }
        };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>(L["Confirmar exclusão"], parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            try
            {
                await EquipamentoService.DeleteAsync(equipamento.Id);
                Snackbar.Add(L["Equipamento excluído."], Severity.Success);
                await Load();
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }
}
