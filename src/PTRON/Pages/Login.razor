@page "/login"
@layout LoginLayout
@attribute [AllowAnonymous]
@using PTRON.Email
@inject IAppEmailSender Email

<PageTitle>Makelectron — Entrar</PageTitle>

<MudPaper Class="pa-6" Elevation="3">
    <div class="d-flex justify-center mb-4">
        <BrandLogo Height="56" />
    </div>
    <MudText Typo="Typo.body2" Class="mb-4">Entre para continuar.</MudText>

    @if (_showError)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4" Dense="true">
            Usuário ou senha inválidos.
        </MudAlert>
    }

    <form method="post" action="/account/login">
        <input type="hidden" name="returnUrl" value="@_returnUrl" />

        <MudText Typo="Typo.caption">Usuário</MudText>
        <input name="username" type="text" autocomplete="username" required
               class="mud-input mud-input-outlined mud-input-outlined-border pa-3 mb-3"
               style="width:100%; box-sizing:border-box; border:1px solid var(--mud-palette-lines-inputs); border-radius:4px; background:transparent; color:inherit;" />

        <MudText Typo="Typo.caption">Senha</MudText>
        <input name="password" type="password" autocomplete="current-password" required
               class="mud-input mud-input-outlined mud-input-outlined-border pa-3 mb-4"
               style="width:100%; box-sizing:border-box; border:1px solid var(--mud-palette-lines-inputs); border-radius:4px; background:transparent; color:inherit;" />

        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                   FullWidth="true" Size="Size.Large">
            Entrar
        </MudButton>
    </form>

    <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-4">
        Não tem conta? <MudLink Href="/cadastro">Criar conta</MudLink>
    </MudText>

    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Class="mt-4"
               FullWidth="true" Disabled="_sendingProbe" OnClick="SendProbeAsync">
        @(_sendingProbe ? "Enviando..." : "Enviar e-mail de teste")
    </MudButton>
    @if (!string.IsNullOrEmpty(_probeMessage))
    {
        <MudAlert Severity="Severity.Info" Class="mt-3" Dense="true">@_probeMessage</MudAlert>
    }
</MudPaper>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private bool _showError;
    private string _returnUrl = "/";
    private bool _sendingProbe;
    private string? _probeMessage;

    protected override void OnInitialized()
    {
        _showError = Error == "1";
        if (!string.IsNullOrWhiteSpace(ReturnUrl) && ReturnUrl.StartsWith('/'))
            _returnUrl = ReturnUrl;
    }

    private async Task SendProbeAsync()
    {
        _sendingProbe = true;
        _probeMessage = null;
        try
        {
            await Email.SendProbeAsync("pedrosa.leonardo@gmail.com");
            _probeMessage = "Pedido enviado para pedrosa.leonardo@gmail.com. Se não chegar, veja o journal.";
        }
        catch (Exception ex)
        {
            _probeMessage = ex.Message;
        }
        finally
        {
            _sendingProbe = false;
        }
    }
}
