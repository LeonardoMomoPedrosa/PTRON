@page "/login"
@layout LoginLayout
@attribute [AllowAnonymous]

<PageTitle>@L["Makelectron — Entrar"]</PageTitle>

<SeoMeta 
    Title="@L["Makelectron — Entrar"]"
    Description="@L["Entre na sua conta Makelectron para gerenciar estoque, controlar produção e calcular custos dos seus produtos."]"
    Robots="noindex, nofollow"
/>

<MudPaper Class="pa-6" Elevation="3">
    <div class="d-flex justify-center mb-4">
        <a href="/" class="brand-home">
            <BrandLogo Height="56" />
        </a>
    </div>
    <MudText Typo="Typo.body2" Class="mb-4">@L["Entre para continuar."]</MudText>

    @if (_error == "inactive")
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4" Dense="true">
            @L["Sua conta ainda não foi ativada. Abra o link que enviamos para o seu e-mail ou"]
            <MudLink Href="@ResendHref">@L["reenvie o e-mail de ativação"]</MudLink>.
        </MudAlert>
    }
    else if (_error == "locked")
    {
        <MudAlert Severity="Severity.Error" Class="mb-4" Dense="true">
            @L["Muitas tentativas de entrada. Aguarde alguns minutos e tente novamente."]
        </MudAlert>
    }
    else if (_error == "expired")
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4" Dense="true">
            @L["A página ficou aberta por muito tempo. Tente entrar novamente."]
        </MudAlert>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <MudAlert Severity="Severity.Error" Class="mb-4" Dense="true">
            @L["E-mail ou senha inválidos."]
        </MudAlert>
    }

    <form method="post" action="/account/login">
        <AntiforgeryToken />
        <input type="hidden" name="returnUrl" value="@_returnUrl" />

        <MudText Typo="Typo.caption">@L["E-mail"]</MudText>
        <input name="username" type="text" autocomplete="username" required maxlength="256" value="@_email"
               class="mud-input mud-input-outlined mud-input-outlined-border pa-3 mb-3"
               style="width:100%; box-sizing:border-box; border:1px solid var(--mud-palette-lines-inputs); border-radius:4px; background:transparent; color:inherit;" />

        <MudText Typo="Typo.caption">@L["Senha"]</MudText>
        <input name="password" type="password" autocomplete="current-password" required
               class="mud-input mud-input-outlined mud-input-outlined-border pa-3 mb-4"
               style="width:100%; box-sizing:border-box; border:1px solid var(--mud-palette-lines-inputs); border-radius:4px; background:transparent; color:inherit;" />

        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                   FullWidth="true" Size="Size.Large">
            @L["Entrar"]
        </MudButton>
    </form>

    <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-3">
        <MudLink Href="/esqueci-senha">@L["Esqueci a senha"]</MudLink>
    </MudText>

    <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-4">
        @L["Não tem conta?"] <MudLink Href="/cadastro">@L["Criar conta"]</MudLink>
    </MudText>
</MudPaper>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "email")]
    public string? Email { get; set; }

    private string? _error;
    private string _email = "";
    private string _returnUrl = "/";

    private string ResendHref => "/ativar?email=" + Uri.EscapeDataString(_email);

    protected override void OnInitialized()
    {
        _error = Error;
        _email = Email ?? "";
        if (!string.IsNullOrWhiteSpace(ReturnUrl) && ReturnUrl.StartsWith('/'))
            _returnUrl = ReturnUrl;
    }
}
