@page "/"

<PageTitle>PTRON — Início</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">PTRON</MudText>
<MudText Typo="Typo.subtitle1" Class="mb-6">
    Controle de produção de equipamentos eletrônicos.
</MudText>

<MudGrid>
    @foreach (var item in _atalhos)
    {
        <MudItem xs="12" sm="6" md="4">
            <MudCard Class="pa-2" Style="height:100%">
                <MudCardContent>
                    <MudIcon Icon="@item.Icon" Color="Color.Primary" Size="Size.Large" />
                    <MudText Typo="Typo.h6" Class="mt-2">@item.Titulo</MudText>
                    <MudText Typo="Typo.body2">@item.Descricao</MudText>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Href="@item.Href" Variant="Variant.Text" Color="Color.Primary">Abrir</MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
    }
</MudGrid>

@code {
    private record Atalho(string Titulo, string Descricao, string Href, string Icon);

    private readonly Atalho[] _atalhos =
    {
        new("Tipos", "Tipos de componente (resistor, diodo...).", "tipos", Icons.Material.Filled.Category),
        new("Insumos", "Componentes com saldo e custo.", "insumos", Icons.Material.Filled.Memory),
        new("Equipamentos", "Modelos e suas listas de insumos.", "equipamentos", Icons.Material.Filled.DeveloperBoard),
        new("Entrada de estoque", "Compra de insumos com custo médio.", "entradas", Icons.Material.Filled.AddShoppingCart),
        new("Produção", "Produzir a partir de um modelo.", "producao", Icons.Material.Filled.PrecisionManufacturing),
        new("Produtos", "Produtos produzidos e custos.", "produtos", Icons.Material.Filled.Inventory2),
    };
}
