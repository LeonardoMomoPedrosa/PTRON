@page "/produtos"
@inject ProdutoService ProdutoService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>@L["Produtos — Makelectron"]</PageTitle>

<SeoMeta 
    Title="@L["Produtos — Makelectron"]"
    Description="@L["Visualize seus produtos fabricados e seus custos"]"
    NoIndex="true"
    NoFollow="true"
/>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h5">@L["Produtos"]</MudText>
    <MudSpacer />
    <MudText Typo="Typo.body2" Class="mud-secondary-text">
        @L["Criados apenas pela produção. Excluir devolve os insumos ao estoque."]
    </MudText>
</MudStack>

<MudPaper>
    <MudTable Items="_produtos"
              Loading="_loading"
              Hover="true"
              Dense="true"
              Breakpoint="Breakpoint.Sm"
              LoadingProgressColor="Color.Primary">
        <HeaderContent>
            <MudTh>#</MudTh>
            <MudTh>@L["Equipamento"]</MudTh>
            <MudTh>@L["Descrição"]</MudTh>
            <MudTh>@L["Data"]</MudTh>
            <MudTh Style="text-align:right">@L["Custo total"]</MudTh>
            <MudTh Style="text-align:right">@L["Ações"]</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="#">@context.Id</MudTd>
            <MudTd DataLabel="@L["Equipamento"]">@context.Equipamento?.Nome</MudTd>
            <MudTd DataLabel="@L["Descrição"]">
                @(string.IsNullOrWhiteSpace(context.DescricaoAdicional) ? "—" : context.DescricaoAdicional)
            </MudTd>
            <MudTd DataLabel="@L["Data"]">@Format.Date(context.Data)</MudTd>
            <MudTd DataLabel="@L["Custo total"]" Style="text-align:right">@Format.Money(context.CustoTotal)</MudTd>
            <MudTd DataLabel="@L["Ações"]" Style="text-align:right">
                <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small"
                               Color="Color.Primary" OnClick="@(() => VerDetalhe(context))" />
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                               Color="Color.Default" OnClick="@(() => EditarDescricao(context))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                               Color="Color.Error" OnClick="@(() => Delete(context))" />
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>@L["Nenhum produto produzido ainda."]</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    private List<Produto> _produtos = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        _loading = true;
        _produtos = await ProdutoService.GetAllAsync();
        _loading = false;
    }

    private async Task VerDetalhe(Produto produto)
    {
        var full = await ProdutoService.GetWithInsumosAsync(produto.Id);
        if (full is null)
        {
            Snackbar.Add(L["Produto não encontrado."], Severity.Error);
            await Load();
            return;
        }

        var parameters = new DialogParameters<ProdutoDetalheDialog>
        {
            { x => x.Produto, full }
        };
        await DialogService.ShowAsync<ProdutoDetalheDialog>(
            L["Produto #{0}", full.Id], parameters);
    }

    private async Task EditarDescricao(Produto produto)
    {
        var parameters = new DialogParameters<ProdutoDescricaoDialog>
        {
            { x => x.ProdutoId, produto.Id },
            { x => x.Descricao, produto.DescricaoAdicional }
        };
        var dialog = await DialogService.ShowAsync<ProdutoDescricaoDialog>(
            L["Descrição do produto #{0}", produto.Id], parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await Load();
        }
    }

    private async Task Delete(Produto produto)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            {
                x => x.Message,
                L["Excluir o produto #{0} ({1})? Os insumos consumidos voltarão ao estoque.", produto.Id, produto.Equipamento?.Nome ?? ""]
            },
            { x => x.ConfirmText, L["Excluir"] }
        };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>(L["Confirmar exclusão"], parameters);
        var result = await dialog.Result;
        if (result is { Canceled: true })
        {
            return;
        }

        try
        {
            await ProdutoService.DeleteAsync(produto.Id);
            Snackbar.Add(L["Produto excluído. Insumos devolvidos ao estoque."], Severity.Success);
            await Load();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
