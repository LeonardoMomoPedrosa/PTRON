@page "/tipos"
@inject TipoInsumoService TipoService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>@L["Tipos — Makelectron"]</PageTitle>

<SeoMeta 
    Title="@L["Tipos de Componentes — Makelectron"]"
    Description="@L["Gerencie os tipos de componentes do seu estoque"]"
    NoIndex="true"
    NoFollow="true"
/>

<div class="tipos-page">
    <div class="tipos-toolbar mb-4">
        <MudText Typo="Typo.h5">@L["Tipos"]</MudText>
        <MudButton StartIcon="@Icons.Material.Filled.Add"
                   Color="Color.Primary"
                   Variant="Variant.Filled"
                   Class="tipos-add"
                   OnClick="OpenCreate">
            @L["Novo tipo"]
        </MudButton>
    </div>

    <div class="tipos-phone">
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-2" />
        }
        else if (_tipos.Count == 0)
        {
            <MudPaper Class="pa-4">
                <MudText>@L["Nenhum tipo cadastrado."]</MudText>
            </MudPaper>
        }
        else
        {
            <MudPaper Class="tipos-list" Elevation="1">
                @foreach (var tipo in _tipos)
                {
                    <div class="tipos-row">
                        <span class="tipos-nome">@tipo.Nome</span>
                        <span class="tipos-actions">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Size="Size.Large"
                                           Color="Color.Primary"
                                           aria-label="@L["Editar {0}", tipo.Nome]"
                                           OnClick="@(() => OpenEdit(tipo))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Size="Size.Large"
                                           Color="Color.Error"
                                           aria-label="@L["Excluir {0}", tipo.Nome]"
                                           OnClick="@(() => Delete(tipo))" />
                        </span>
                    </div>
                }
            </MudPaper>
        }
    </div>

    <MudPaper Class="tipos-desktop">
        <MudTable Items="_tipos"
                  Loading="_loading"
                  Hover="true"
                  Dense="true"
                  Breakpoint="Breakpoint.None"
                  LoadingProgressColor="Color.Primary">
            <HeaderContent>
                <MudTh>@L["Nome"]</MudTh>
                <MudTh Style="text-align:right">@L["Ações"]</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@L["Nome"]">@context.Nome</MudTd>
                <MudTd DataLabel="@L["Ações"]" Style="text-align:right">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                   Size="Size.Small"
                                   Color="Color.Primary"
                                   aria-label="@L["Editar {0}", context.Nome]"
                                   OnClick="@(() => OpenEdit(context))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Size="Size.Small"
                                   Color="Color.Error"
                                   aria-label="@L["Excluir {0}", context.Nome]"
                                   OnClick="@(() => Delete(context))" />
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText>@L["Nenhum tipo cadastrado."]</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>
</div>

@code {
    private List<TipoInsumo> _tipos = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        _loading = true;
        _tipos = await TipoService.GetAllAsync();
        _loading = false;
    }

    private async Task OpenCreate()
    {
        var dialog = await DialogService.ShowAsync<TipoDialog>(L["Novo tipo"]);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: TipoInsumo novo })
        {
            try
            {
                await TipoService.CreateAsync(novo);
                Snackbar.Add(L["Tipo criado."], Severity.Success);
                await Load();
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }

    private async Task OpenEdit(TipoInsumo tipo)
    {
        var parameters = new DialogParameters<TipoDialog> { { x => x.Tipo, tipo } };
        var dialog = await DialogService.ShowAsync<TipoDialog>(L["Editar tipo"], parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: TipoInsumo editado })
        {
            try
            {
                await TipoService.UpdateAsync(editado);
                Snackbar.Add(L["Tipo atualizado."], Severity.Success);
                await Load();
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }

    private async Task Delete(TipoInsumo tipo)
    {
        var count = await TipoService.CountInsumosAsync(tipo.Id);
        if (count > 0)
        {
            Snackbar.Add(
                L["Não é possível excluir \"{0}\": {1} insumo(s) vinculado(s).", tipo.Nome, count],
                Severity.Warning);
            return;
        }

        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.Message, L["Excluir o tipo \"{0}\"?", tipo.Nome] },
            { x => x.ConfirmText, L["Excluir"] },
            { x => x.MarkerClass, "tipo-flow-dialog" }
        };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>(L["Confirmar exclusão"], parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            try
            {
                await TipoService.DeleteAsync(tipo.Id);
                Snackbar.Add(L["Tipo excluído."], Severity.Success);
                await Load();
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }
}
