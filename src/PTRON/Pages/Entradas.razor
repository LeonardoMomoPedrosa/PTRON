@page "/entradas"
@inject EntradaEstoqueService EntradaService
@inject InsumoService InsumoService
@inject EntradaCartState CartState
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Entrada de estoque</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">Entrada de estoque</MudText>

<MudTabs Elevation="1" Rounded="true" ApplyEffectsToContainer="true">
    <MudTabPanel Text="Nova entrada" Icon="@Icons.Material.Filled.AddShoppingCart">
        <MudPaper Class="pa-4 mb-4 mt-4" Outlined="true">
            <MudGrid Class="align-end">
                <MudItem xs="12" sm="3">
                    <MudSelect T="string" @bind-Value="CartState.Moeda" Label="Moeda" AnchorOrigin="Origin.BottomCenter">
                        <MudSelectItem T="string" Value="@Moedas.Brl">R$</MudSelectItem>
                        <MudSelectItem T="string" Value="@Moedas.Usd">US$</MudSelectItem>
                    </MudSelect>
                </MudItem>
                @if (EmDolar)
                {
                    <MudItem xs="12" sm="3">
                        <MudNumericField T="decimal" @bind-Value="CartState.Cambio"
                                         Label="Câmbio (R$ por US$)"
                                         Min="0m" Step="0.0001m" Format="N4" Culture="@Format.Culture"
                                         HelperText="Quantos reais valem 1 dólar"
                                         Immediate="true" HideSpinButtons="true" />
                    </MudItem>
                }
                <MudItem xs="6" sm="3">
                    <MudNumericField T="decimal" @bind-Value="CartState.Frete"
                                     Label="@($"Frete ({Moedas.Symbol(CartState.Moeda)})")"
                                     Min="0m" Step="0.01m" Format="N2" Culture="@Format.Culture"
                                     Immediate="true" HideSpinButtons="true" />
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudNumericField T="decimal" @bind-Value="CartState.Impostos"
                                     Label="@($"Impostos ({Moedas.Symbol(CartState.Moeda)})")"
                                     Min="0m" Step="0.01m" Format="N2" Culture="@Format.Culture"
                                     Immediate="true" HideSpinButtons="true" />
                </MudItem>
            </MudGrid>
            @if (EmDolar)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">
                    Os preços dos produtos, o frete e os impostos desta entrada são em dólar.
                    O custo do estoque será convertido para reais pelo câmbio informado.
                </MudAlert>
            }
        </MudPaper>

        <MudPaper Class="pa-4 mb-4" Outlined="true">
            <MudGrid Class="align-end">
                <MudItem xs="12" sm="5">
                    <MudAutocomplete T="Insumo" @ref="_insumoSearch"
                                     @bind-Value="_novoInsumo"
                                     @bind-Value:after="AfterInsumoChanged"
                                     Label="Insumo"
                                     SearchFunc="SearchInsumos"
                                     ToStringFunc="@(i => i is null ? string.Empty : InsumoLabel(i))"
                                     ResetValueOnEmptyText="true"
                                     CoerceText="true"
                                     Clearable="true"
                                     AnchorOrigin="Origin.BottomCenter"
                                     OnKeyUp="OnInsumoKeyUp" />
                </MudItem>
                <MudItem xs="6" sm="2">
                    <MudNumericField T="decimal" @ref="_qtdField"
                                     @bind-Value="_novaQtd" Label="Quantidade"
                                     Min="0m" Step="1m" Immediate="true" HideSpinButtons="true"
                                     OnKeyUp="OnQtdKeyUp" />
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudNumericField T="decimal" @ref="_precoField"
                                     @bind-Value="_novoPreco" Label="@PrecoLabel"
                                     Min="0m" Step="0.01m" Format="N2" Culture="@Format.Culture"
                                     Immediate="true" HideSpinButtons="true"
                                     OnKeyUp="OnPrecoKeyUp" />
                </MudItem>
                <MudItem xs="12" sm="2">
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.Add" OnClick="AddLinha" FullWidth="true">
                        Adicionar
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudPaper Class="mb-4">
            <MudTable Items="_cart" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
                <HeaderContent>
                    <MudTh Style="width:64px">Foto</MudTh>
                    <MudTh>Insumo</MudTh>
                    <MudTh Style="text-align:right">Qtd</MudTh>
                    <MudTh Style="text-align:right">Preço unit. (@Moedas.Symbol(CartState.Moeda))</MudTh>
                    <MudTh Style="text-align:right">Subtotal</MudTh>
                    <MudTh Style="text-align:right">Ações</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Foto">
                        @if (!string.IsNullOrEmpty(context.Insumo?.FotoPath))
                        {
                            <MudImage Src="@context.Insumo.FotoPath" Width="40" Height="40"
                                      ObjectFit="ObjectFit.Cover" Class="rounded" />
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Memory" Color="Color.Default" />
                        }
                    </MudTd>
                    <MudTd DataLabel="Insumo">
                        @if (context.Insumo is not null)
                        {
                            <MudText Typo="Typo.body2">@context.Insumo.Nome</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                @InsumoDetalhe(context.Insumo)
                            </MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="Qtd" Style="text-align:right">
                        <MudNumericField T="decimal" @bind-Value="context.Qtd" Min="0.0001m"
                                         Variant="Variant.Text" Margin="Margin.Dense"
                                         Style="max-width:100px; margin-left:auto;" HideSpinButtons="true" />
                    </MudTd>
                    <MudTd DataLabel="Preço unit." Style="text-align:right">
                        <MudNumericField T="decimal" @bind-Value="context.PrecoUnitario" Min="0m"
                                         Variant="Variant.Text" Margin="Margin.Dense"
                                         Format="N2" Culture="@Format.Culture"
                                         Style="max-width:120px; margin-left:auto;" HideSpinButtons="true" />
                    </MudTd>
                    <MudTd DataLabel="Subtotal" Style="text-align:right">
                        @Format.Money(context.Qtd * context.PrecoUnitario, CartState.Moeda)
                    </MudTd>
                    <MudTd Style="text-align:right">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                       Color="Color.Error" OnClick="@(() => RemoverLinha(context))" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText>Nenhum item no carrinho. Adicione insumos acima.</MudText>
                </NoRecordsContent>
                <FooterContent>
                    <MudTd></MudTd>
                    <MudTd></MudTd>
                    <MudTd></MudTd>
                    <MudTd Style="text-align:right"><b>Produtos</b></MudTd>
                    <MudTd Style="text-align:right"><b>@Format.Money(TotalProdutos, CartState.Moeda)</b></MudTd>
                    <MudTd></MudTd>
                </FooterContent>
            </MudTable>
        </MudPaper>

        <MudPaper Class="pa-4 mb-4" Outlined="true">
            <MudGrid>
                <MudItem xs="6" sm="3">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Produtos</MudText>
                    <MudText>@Format.Money(TotalProdutos, CartState.Moeda)</MudText>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Frete</MudText>
                    <MudText>@Format.Money(CartState.Frete, CartState.Moeda)</MudText>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Impostos</MudText>
                    <MudText>@Format.Money(CartState.Impostos, CartState.Moeda)</MudText>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Total @Moedas.Symbol(CartState.Moeda)</MudText>
                    <MudText Typo="Typo.subtitle1"><b>@Format.Money(TotalMoeda, CartState.Moeda)</b></MudText>
                </MudItem>
                @if (EmDolar && CartState.Cambio > 0)
                {
                    <MudItem xs="12" sm="3">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Total em R$</MudText>
                        <MudText Typo="Typo.subtitle1"><b>@Format.Money(TotalMoeda * CartState.Cambio)</b></MudText>
                    </MudItem>
                }
            </MudGrid>
        </MudPaper>

        <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
            <MudButton Variant="Variant.Outlined" OnClick="LimparCart" Disabled="@(!_cart.Any())">
                Limpar
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Visibility"
                       OnClick="Finalizar" Disabled="@(!_cart.Any())">
                Pré-visualizar
            </MudButton>
        </MudStack>
    </MudTabPanel>

    <MudTabPanel Text="Histórico" Icon="@Icons.Material.Filled.History">
        <MudTable Items="_historico" Loading="_loadingHistorico" Dense="true" Hover="true" Class="mt-4"
                  Breakpoint="Breakpoint.Sm" LoadingProgressColor="Color.Primary">
            <HeaderContent>
                <MudTh>Data</MudTh>
                <MudTh>Moeda</MudTh>
                <MudTh Style="text-align:right">Itens</MudTh>
                <MudTh Style="text-align:right">Total (R$)</MudTh>
                <MudTh Style="text-align:right">Detalhe</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Data">@Format.Date(context.Data)</MudTd>
                <MudTd DataLabel="Moeda">
                    @Moedas.Symbol(context.Moeda)
                    @if (context.Moeda == Moedas.Usd)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            câmbio @Format.Money(context.Cambio)
                        </MudText>
                    }
                </MudTd>
                <MudTd DataLabel="Itens" Style="text-align:right">@context.Itens.Count</MudTd>
                <MudTd DataLabel="Total (R$)" Style="text-align:right">
                    @Format.Money(context.TotalBrl)
                </MudTd>
                <MudTd Style="text-align:right">
                    <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small"
                                   Color="Color.Primary" OnClick="@(() => VerDetalhe(context))" />
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText>Nenhuma entrada registrada.</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudTabPanel>
</MudTabs>

@code {
    private MudAutocomplete<Insumo>? _insumoSearch;
    private MudNumericField<decimal>? _qtdField;
    private MudNumericField<decimal>? _precoField;
    private List<Insumo> _insumos = new();
    private List<EntradaEstoque> _historico = new();
    private bool _loadingHistorico = true;
    private string? _pendingFocus; // "qtd" | "preco" | "insumo"
    private bool _enterOnInsumo;

    private Insumo? _novoInsumo;
    private decimal _novaQtd = 1m;
    private decimal _novoPreco;

    private List<EntradaCartState.CartLine> _cart => CartState.Lines;
    private bool EmDolar => CartState.Moeda == Moedas.Usd;
    private string PrecoLabel => EmDolar ? "Preço unitário (US$)" : "Preço unitário (R$)";
    private decimal TotalProdutos => _cart.Sum(c => c.Qtd * c.PrecoUnitario);
    private decimal TotalMoeda => TotalProdutos + CartState.Frete + CartState.Impostos;

    private static readonly DialogOptions PreviewDialogOptions = new()
    {
        MaxWidth = MaxWidth.ExtraLarge,
        FullWidth = true,
        CloseOnEscapeKey = true
    };

    private static bool IsEnter(KeyboardEventArgs e)
        => e.Key is "Enter" or "NumpadEnter";

    protected override async Task OnInitializedAsync()
    {
        _insumos = await InsumoService.GetAllAsync();
        RehydrateCart();
        await LoadHistorico();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingFocus is null)
        {
            return;
        }

        var target = _pendingFocus;
        _pendingFocus = null;

        switch (target)
        {
            case "qtd" when _qtdField is not null:
                await _qtdField.FocusAsync();
                await _qtdField.SelectAsync();
                break;
            case "preco" when _precoField is not null:
                await _precoField.FocusAsync();
                await _precoField.SelectAsync();
                break;
            case "insumo" when _insumoSearch is not null:
                await _insumoSearch.FocusAsync();
                break;
        }
    }

    private void RequestFocus(string target)
    {
        _pendingFocus = target;
        StateHasChanged();
    }

    private void RehydrateCart()
    {
        for (var i = _cart.Count - 1; i >= 0; i--)
        {
            var line = _cart[i];
            var fresh = _insumos.FirstOrDefault(x => x.Id == line.InsumoId);
            if (fresh is null)
            {
                _cart.RemoveAt(i);
            }
            else
            {
                line.Insumo = fresh;
            }
        }
    }

    private async Task LoadHistorico()
    {
        _loadingHistorico = true;
        _historico = await EntradaService.GetHistoricoAsync();
        _loadingHistorico = false;
    }

    private Task<IEnumerable<Insumo>> SearchInsumos(string? value, CancellationToken token)
    {
        IEnumerable<Insumo> result = _insumos.Where(i => InsumoService.MatchesSearch(i, value));
        return Task.FromResult(result);
    }

    private static string InsumoLabel(Insumo i)
        => $"{i.Nome} · {InsumoDetalhe(i)} (saldo: {Format.Number(i.Saldo)} · {Format.Money(i.CustoUnitario)})";

    private static string InsumoDetalhe(Insumo i)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(i.TipoInsumo?.Nome)) parts.Add(i.TipoInsumo.Nome);
        if (!string.IsNullOrWhiteSpace(i.Valor)) parts.Add(i.Valor!);
        if (!string.IsNullOrWhiteSpace(i.Potencia)) parts.Add(i.Potencia!);
        if (!string.IsNullOrWhiteSpace(i.Voltagem)) parts.Add(i.Voltagem!);
        return parts.Count == 0 ? "—" : string.Join(" · ", parts);
    }

    /// <summary>
    /// MudAutocomplete selects on KeyUp (and reopens the menu on Enter when closed).
    /// After that, if an item is selected, close the menu and move to quantity.
    /// </summary>
    private async Task OnInsumoKeyUp(KeyboardEventArgs e)
    {
        if (!IsEnter(e))
        {
            return;
        }

        _enterOnInsumo = true;
        if (_novoInsumo is not null)
        {
            await AdvanceFromInsumoAsync();
        }
    }

    private async Task AfterInsumoChanged()
    {
        // Selection from Enter often binds after KeyUp — advance once value arrives.
        if (_enterOnInsumo && _novoInsumo is not null)
        {
            await AdvanceFromInsumoAsync();
        }
    }

    private async Task AdvanceFromInsumoAsync()
    {
        _enterOnInsumo = false;
        if (_insumoSearch is not null)
        {
            await _insumoSearch.CloseMenuAsync();
        }

        RequestFocus("qtd");
    }

    private Task OnQtdKeyUp(KeyboardEventArgs e)
    {
        if (IsEnter(e))
        {
            RequestFocus("preco");
        }

        return Task.CompletedTask;
    }

    private async Task OnPrecoKeyUp(KeyboardEventArgs e)
    {
        if (IsEnter(e))
        {
            await AddLinha();
        }
    }

    private Task AddLinha()
    {
        if (_novoInsumo is null)
        {
            Snackbar.Add("Selecione um insumo.", Severity.Warning);
            return Task.CompletedTask;
        }

        if (_novaQtd <= 0)
        {
            Snackbar.Add("A quantidade deve ser maior que zero.", Severity.Warning);
            return Task.CompletedTask;
        }

        if (_novoPreco < 0)
        {
            Snackbar.Add("O preço unitário não pode ser negativo.", Severity.Warning);
            return Task.CompletedTask;
        }

        var existing = _cart.FirstOrDefault(c => c.InsumoId == _novoInsumo.Id);
        if (existing is not null)
        {
            var totalQtd = existing.Qtd + _novaQtd;
            existing.PrecoUnitario = (existing.Qtd * existing.PrecoUnitario + _novaQtd * _novoPreco) / totalQtd;
            existing.Qtd = totalQtd;
        }
        else
        {
            _cart.Add(new EntradaCartState.CartLine
            {
                InsumoId = _novoInsumo.Id,
                Insumo = _novoInsumo,
                Qtd = _novaQtd,
                PrecoUnitario = _novoPreco
            });
        }

        _novoInsumo = null;
        _novaQtd = 1m;
        _novoPreco = 0m;
        RequestFocus("insumo");
        return Task.CompletedTask;
    }

    private void RemoverLinha(EntradaCartState.CartLine line) => _cart.Remove(line);

    private void LimparCart() => CartState.Clear();

    private EntradaCommand BuildCommand() => new()
    {
        Moeda = CartState.Moeda,
        Cambio = CartState.Cambio,
        Frete = CartState.Frete,
        Impostos = CartState.Impostos,
        Itens = _cart.Select(c => new EntradaLinhaInput
        {
            InsumoId = c.InsumoId,
            Qtd = c.Qtd,
            PrecoUnitario = c.PrecoUnitario
        }).ToList()
    };

    private async Task Finalizar()
    {
        if (!_cart.Any())
        {
            return;
        }

        if (_cart.Any(c => c.Qtd <= 0 || c.PrecoUnitario < 0))
        {
            Snackbar.Add("Corrija quantidade e preço de todos os itens antes de finalizar.", Severity.Warning);
            return;
        }

        if (CartState.Frete < 0 || CartState.Impostos < 0)
        {
            Snackbar.Add("Frete e impostos não podem ser negativos.", Severity.Warning);
            return;
        }

        if (EmDolar && CartState.Cambio <= 0)
        {
            Snackbar.Add("Informe o câmbio (quantos R$ valem 1 US$).", Severity.Warning);
            return;
        }

        EntradaRateio rateio;
        try
        {
            rateio = EntradaService.Preview(BuildCommand());
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            return;
        }

        var itens = rateio.Linhas.Select(linha =>
        {
            var cart = _cart.FirstOrDefault(c => c.InsumoId == linha.InsumoId);
            return new EntradaPreviewDialog.Item
            {
                Nome = cart?.Insumo?.Nome ?? $"Insumo {linha.InsumoId}",
                Detalhe = cart?.Insumo is null ? string.Empty : InsumoDetalhe(cart.Insumo),
                Linha = linha
            };
        }).ToList();

        var parameters = new DialogParameters<EntradaPreviewDialog>
        {
            { x => x.Rateio, rateio },
            { x => x.Itens, itens }
        };
        var dialog = await DialogService.ShowAsync<EntradaPreviewDialog>(
            "Pré-visualização da entrada", parameters, PreviewDialogOptions);
        var result = await dialog.Result;
        if (result is { Canceled: true })
        {
            return;
        }

        try
        {
            await EntradaService.FinalizarAsync(BuildCommand());
            Snackbar.Add("Entrada de estoque finalizada.", Severity.Success);
            CartState.Clear();
            _insumos = await InsumoService.GetAllAsync();
            await LoadHistorico();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task VerDetalhe(EntradaEstoque entrada)
    {
        var parameters = new DialogParameters<EntradaDetalheDialog>
        {
            { x => x.Entrada, entrada }
        };
        await DialogService.ShowAsync<EntradaDetalheDialog>(
            $"Entrada #{entrada.Id} — {Format.Date(entrada.Data)}", parameters, PreviewDialogOptions);
    }
}
