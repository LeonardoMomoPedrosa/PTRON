@page "/insumos"
@inject InsumoService InsumoService
@inject TipoInsumoService TipoService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Insumos</PageTitle>

<div class="insumos-page">
    <div class="insumos-toolbar mb-4">
        <MudText Typo="Typo.h5">Insumos</MudText>
        <MudButton StartIcon="@Icons.Material.Filled.Add"
                   Color="Color.Primary"
                   Variant="Variant.Filled"
                   Class="insumos-add"
                   OnClick="OpenCreate">
            Novo insumo
        </MudButton>
    </div>

    <MudPaper Class="pa-4 mb-4 insumos-filters">
        <MudGrid>
            <MudItem xs="12" sm="5">
                <MudTextField @bind-Value="_search"
                              Label="Buscar por nome"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Immediate="true"
                              DebounceInterval="300"
                              OnDebounceIntervalElapsed="ReloadFromStart"
                              Clearable="true" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudSelect T="int?" @bind-Value="_tipoFiltro" @bind-Value:after="ReloadFromStart"
                           Label="Filtrar por tipo"
                           Clearable="true" AnchorOrigin="Origin.BottomCenter">
                    @foreach (var tipo in _tipos)
                    {
                        <MudSelectItem T="int?" Value="tipo.Id">@tipo.Nome</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudNumericField T="int" Value="_pageSize" ValueChanged="OnPageSizeChanged"
                                 Label="Itens por página" Min="1" Max="@InsumoService.MaxPageSize"
                                 Variant="Variant.Text" />
            </MudItem>
        </MudGrid>
    </MudPaper>

    <div class="insumos-phone">
        @if (_loading && _items.Count == 0)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-2" />
        }
        else if (_items.Count == 0)
        {
            <MudPaper Class="pa-4">
                <MudText>Nenhum insumo encontrado.</MudText>
            </MudPaper>
        }
        else
        {
            @if (_loading)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-2" />
            }
            <MudPaper Class="insumos-list" Elevation="1">
                @foreach (var insumo in _items)
                {
                    var specs = Especificacoes(insumo);
                    <div class="insumos-row">
                        <div class="insumos-main">
                            @if (!string.IsNullOrEmpty(insumo.FotoPath))
                            {
                                <MudImage Src="@insumo.FotoPath" Width="48" Height="48"
                                          ObjectFit="ObjectFit.Cover" Class="rounded insumos-foto" />
                            }
                            else
                            {
                                <span class="insumos-foto insumos-foto-empty">
                                    <MudIcon Icon="@Icons.Material.Filled.Memory" />
                                </span>
                            }
                            <div class="insumos-text">
                                <span class="insumos-nome">@insumo.Nome</span>
                                <span class="insumos-meta">@insumo.TipoInsumo?.Nome</span>
                                @if (specs != "—")
                                {
                                    <span class="insumos-meta">@specs</span>
                                }
                                <span class="insumos-meta">Saldo @Format.Number(insumo.Saldo) · @Format.Money(insumo.CustoUnitario)</span>
                            </div>
                        </div>
                        <span class="insumos-actions">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Size="Size.Large"
                                           Color="Color.Primary"
                                           aria-label="@($"Editar {insumo.Nome}")"
                                           OnClick="@(() => OpenEdit(insumo))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Size="Size.Large"
                                           Color="Color.Error"
                                           aria-label="@($"Excluir {insumo.Nome}")"
                                           OnClick="@(() => Delete(insumo))" />
                        </span>
                    </div>
                }
            </MudPaper>
            @if (_totalCount > _pageSize)
            {
                <div class="insumos-pager">
                    <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft"
                                   Size="Size.Large"
                                   Color="Color.Primary"
                                   Disabled="@(_page == 0 || _loading)"
                                   aria-label="Página anterior"
                                   OnClick="PreviousPage" />
                    <span class="insumos-pager-label">@FirstItem-@LastItem de @_totalCount</span>
                    <MudIconButton Icon="@Icons.Material.Filled.ChevronRight"
                                   Size="Size.Large"
                                   Color="Color.Primary"
                                   Disabled="@(!HasNextPage || _loading)"
                                   aria-label="Próxima página"
                                   OnClick="NextPage" />
                </div>
            }
            else if (_totalCount > 0)
            {
                <MudText Typo="Typo.body2" Class="insumos-pager-label mt-2">@_totalCount de @_totalCount</MudText>
            }
        }
    </div>

<MudPaper Class="insumos-desktop">
    <MudTable @ref="_table" T="Insumo" ServerData="LoadPage"
              RowsPerPage="@_pageSize"
              Hover="true"
              Dense="true"
              Breakpoint="Breakpoint.None"
              LoadingProgressColor="Color.Primary">
        <HeaderContent>
            <MudTh Style="width:64px">Foto</MudTh>
            <MudTh>Nome</MudTh>
            <MudTh>Tipo</MudTh>
            <MudTh>Especificações</MudTh>
            <MudTh Style="text-align:right">Saldo</MudTh>
            <MudTh Style="text-align:right">Custo unit.</MudTh>
            <MudTh Style="text-align:right">Ações</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Foto">
                @if (!string.IsNullOrEmpty(context.FotoPath))
                {
                    <MudImage Src="@context.FotoPath" Width="40" Height="40"
                              ObjectFit="ObjectFit.Cover" Class="rounded" />
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.Memory" Color="Color.Default" />
                }
            </MudTd>
            <MudTd DataLabel="Nome">@context.Nome</MudTd>
            <MudTd DataLabel="Tipo">@context.TipoInsumo?.Nome</MudTd>
            <MudTd DataLabel="Especificações">@Especificacoes(context)</MudTd>
            <MudTd DataLabel="Saldo" Style="text-align:right">@Format.Number(context.Saldo)</MudTd>
            <MudTd DataLabel="Custo unit." Style="text-align:right">@Format.Money(context.CustoUnitario)</MudTd>
            <MudTd DataLabel="Ações" Style="text-align:right">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                               Color="Color.Primary" OnClick="@(() => OpenEdit(context))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                               Color="Color.Error" OnClick="@(() => Delete(context))" />
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>Nenhum insumo encontrado.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager HideRowsPerPage="true"
                           InfoFormat="{first_item}-{last_item} de {all_items}" />
        </PagerContent>
    </MudTable>
</MudPaper>
</div>

@code {
    private const int DefaultPageSize = 25;

    private MudTable<Insumo> _table = null!;
    private List<TipoInsumo> _tipos = new();
    private List<Insumo> _items = new();
    private string? _search;
    private int? _tipoFiltro;
    private int _pageSize = DefaultPageSize;
    private int _page;
    private int _totalCount;
    private bool _loading = true;

    private int FirstItem => _totalCount == 0 ? 0 : _page * _pageSize + 1;
    private int LastItem => Math.Min(_totalCount, (_page + 1) * _pageSize);
    private bool HasNextPage => (_page + 1) * _pageSize < _totalCount;

    protected override async Task OnInitializedAsync()
    {
        _tipos = await TipoService.GetAllAsync();
    }

    private async Task<TableData<Insumo>> LoadPage(TableState state, CancellationToken cancellationToken)
    {
        var page = await InsumoService.GetPageAsync(
            _search, _tipoFiltro, state.Page, state.PageSize, cancellationToken);
        _items = page.Items.ToList();
        _totalCount = page.TotalCount;
        _page = state.Page;
        _loading = false;
        await InvokeAsync(StateHasChanged);
        return new TableData<Insumo> { Items = page.Items, TotalItems = page.TotalCount };
    }

    private Task OnPageSizeChanged(int size)
    {
        _pageSize = Math.Clamp(size, 1, InsumoService.MaxPageSize);
        _loading = true;
        _table.SetRowsPerPage(_pageSize);
        return Task.CompletedTask;
    }

    private void PreviousPage()
    {
        if (_page == 0 || _loading)
        {
            return;
        }

        _loading = true;
        _table.NavigateTo(_page - 1);
    }

    private void NextPage()
    {
        if (!HasNextPage || _loading)
        {
            return;
        }

        _loading = true;
        _table.NavigateTo(_page + 1);
    }

    private async Task ReloadFromStart()
    {
        _loading = true;
        if (_table.CurrentPage != 0)
        {
            _table.NavigateTo(0);
            return;
        }

        await _table.ReloadServerData();
    }

    private Task Reload() => _table.ReloadServerData();

    private static string Especificacoes(Insumo i)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(i.Valor)) parts.Add(i.Valor!);
        if (!string.IsNullOrWhiteSpace(i.Potencia)) parts.Add(i.Potencia!);
        if (!string.IsNullOrWhiteSpace(i.Voltagem)) parts.Add(i.Voltagem!);
        return parts.Count == 0 ? "—" : string.Join(" · ", parts);
    }

    private async Task OpenCreate()
    {
        if (_tipos.Count == 0)
        {
            Snackbar.Add("Cadastre ao menos um tipo antes de criar insumos.", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters<InsumoDialog>
        {
            { x => x.DefaultTipoInsumoId, _tipoFiltro }
        };
        var dialog = await DialogService.ShowAsync<InsumoDialog>("Novo insumo", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: Insumo novo })
        {
            try
            {
                await InsumoService.CreateAsync(novo);
                Snackbar.Add("Insumo criado.", Severity.Success);
                await Reload();
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }

    private async Task OpenEdit(Insumo insumo)
    {
        var parameters = new DialogParameters<InsumoDialog> { { x => x.Insumo, insumo } };
        var dialog = await DialogService.ShowAsync<InsumoDialog>("Editar insumo", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: Insumo data })
        {
            try
            {
                // Id == 0 means the user chose "Criar cópia com outro valor".
                if (data.Id == 0)
                {
                    await InsumoService.CreateAsync(data);
                    Snackbar.Add("Insumo criado (cópia).", Severity.Success);
                }
                else
                {
                    await InsumoService.UpdateAsync(data);
                    Snackbar.Add("Insumo atualizado.", Severity.Success);
                }

                await Reload();
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }

    private async Task Delete(Insumo insumo)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.Message, $"Excluir o insumo \"{insumo.Nome}\"?" },
            { x => x.ConfirmText, "Excluir" },
            { x => x.MarkerClass, "insumo-flow-dialog" }
        };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Confirmar exclusão", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            try
            {
                await InsumoService.DeleteAsync(insumo.Id);
                Snackbar.Add("Insumo excluído.", Severity.Success);
                await Reload();
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }
}
