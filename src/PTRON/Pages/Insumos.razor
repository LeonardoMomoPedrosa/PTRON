@page "/insumos"
@inject InsumoService InsumoService
@inject TipoInsumoService TipoService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Insumos</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h5">Insumos</MudText>
    <MudSpacer />
    <MudButton StartIcon="@Icons.Material.Filled.Add"
               Color="Color.Primary"
               Variant="Variant.Filled"
               OnClick="OpenCreate">
        Novo insumo
    </MudButton>
</MudStack>

<MudPaper Class="pa-4 mb-4">
    <MudGrid>
        <MudItem xs="12" sm="7">
            <MudTextField @bind-Value="_search"
                          Label="Buscar por nome"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true"
                          DebounceInterval="300"
                          OnDebounceIntervalElapsed="Load"
                          Clearable="true" />
        </MudItem>
        <MudItem xs="12" sm="5">
            <MudSelect T="int?" @bind-Value="_tipoFiltro" @bind-Value:after="Load"
                       Label="Filtrar por tipo"
                       Clearable="true" AnchorOrigin="Origin.BottomCenter">
                @foreach (var tipo in _tipos)
                {
                    <MudSelectItem T="int?" Value="tipo.Id">@tipo.Nome</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudPaper>
    <MudTable Items="_insumos"
              Loading="_loading"
              Hover="true"
              Dense="true"
              Breakpoint="Breakpoint.Sm"
              LoadingProgressColor="Color.Primary">
        <HeaderContent>
            <MudTh Style="width:64px">Foto</MudTh>
            <MudTh>Nome</MudTh>
            <MudTh>Tipo</MudTh>
            <MudTh>Especificações</MudTh>
            <MudTh Style="text-align:right">Saldo</MudTh>
            <MudTh Style="text-align:right">Custo unit.</MudTh>
            <MudTh Style="text-align:right">Ações</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Foto">
                @if (!string.IsNullOrEmpty(context.FotoPath))
                {
                    <MudImage Src="@context.FotoPath" Width="40" Height="40"
                              ObjectFit="ObjectFit.Cover" Class="rounded" />
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.Memory" Color="Color.Default" />
                }
            </MudTd>
            <MudTd DataLabel="Nome">@context.Nome</MudTd>
            <MudTd DataLabel="Tipo">@context.TipoInsumo?.Nome</MudTd>
            <MudTd DataLabel="Especificações">@Especificacoes(context)</MudTd>
            <MudTd DataLabel="Saldo" Style="text-align:right">@Format.Number(context.Saldo)</MudTd>
            <MudTd DataLabel="Custo unit." Style="text-align:right">@Format.Money(context.CustoUnitario)</MudTd>
            <MudTd DataLabel="Ações" Style="text-align:right">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                               Color="Color.Primary" OnClick="@(() => OpenEdit(context))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                               Color="Color.Error" OnClick="@(() => Delete(context))" />
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>Nenhum insumo encontrado.</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    private List<Insumo> _insumos = new();
    private List<TipoInsumo> _tipos = new();
    private string? _search;
    private int? _tipoFiltro;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _tipos = await TipoService.GetAllAsync();
        await Load();
    }

    private async Task Load()
    {
        _loading = true;
        _insumos = await InsumoService.GetAllAsync(_search, _tipoFiltro);
        _loading = false;
    }

    private static string Especificacoes(Insumo i)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(i.Valor)) parts.Add(i.Valor!);
        if (!string.IsNullOrWhiteSpace(i.Potencia)) parts.Add(i.Potencia!);
        if (!string.IsNullOrWhiteSpace(i.Voltagem)) parts.Add(i.Voltagem!);
        return parts.Count == 0 ? "—" : string.Join(" · ", parts);
    }

    private async Task OpenCreate()
    {
        if (_tipos.Count == 0)
        {
            Snackbar.Add("Cadastre ao menos um tipo antes de criar insumos.", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters<InsumoDialog>
        {
            { x => x.DefaultTipoInsumoId, _tipoFiltro }
        };
        var dialog = await DialogService.ShowAsync<InsumoDialog>("Novo insumo", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: Insumo novo })
        {
            try
            {
                await InsumoService.CreateAsync(novo);
                Snackbar.Add("Insumo criado.", Severity.Success);
                await Load();
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }

    private async Task OpenEdit(Insumo insumo)
    {
        var parameters = new DialogParameters<InsumoDialog> { { x => x.Insumo, insumo } };
        var dialog = await DialogService.ShowAsync<InsumoDialog>("Editar insumo", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: Insumo data })
        {
            try
            {
                // Id == 0 means the user chose "Criar cópia com outro valor".
                if (data.Id == 0)
                {
                    await InsumoService.CreateAsync(data);
                    Snackbar.Add("Insumo criado (cópia).", Severity.Success);
                }
                else
                {
                    await InsumoService.UpdateAsync(data);
                    Snackbar.Add("Insumo atualizado.", Severity.Success);
                }

                await Load();
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }

    private async Task Delete(Insumo insumo)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.Message, $"Excluir o insumo \"{insumo.Nome}\"?" },
            { x => x.ConfirmText, "Excluir" }
        };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Confirmar exclusão", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            try
            {
                await InsumoService.DeleteAsync(insumo.Id);
                Snackbar.Add("Insumo excluído.", Severity.Success);
                await Load();
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }
}
